---
interface Props {
	fileName: string;
	fileUrl: string;
	format?: 'CSV' | 'XLSX' | 'GEOJSON' | 'JSON';
	size?: string;
	license?: string;
}

const {
	fileName,
	fileUrl,
	format = 'CSV',
	size = '42 KB',
	license = 'Açık Veri / CC-BY 4.0'
} = Astro.props;
---

<div class="dataset-box">
	<div class="dataset-info">
		<div class="dataset-badge">{format}</div>
		<div>
			<h4 class="dataset-title">{fileName}</h4>
			<p class="dataset-meta">Dosya boyutu: {size} • Lisans: {license}</p>
		</div>
	</div>
	<a href={fileUrl} download class="download-btn">
		<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
			<polyline points="7 10 12 15 17 10"></polyline>
			<line x1="12" y1="15" x2="12" y2="3"></line>
		</svg>
		<span>Ham Veriyi İndir</span>
	</a>
</div>

<style>
	.dataset-box {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 1rem;
		background: #f0fdf4;
		border: 1px solid #bbf7d0;
		padding: 1.25rem 1.5rem;
		border-radius: 12px;
		margin: 2rem 0;
	}
	.dataset-info {
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	.dataset-badge {
		background: #15803d;
		color: #ffffff;
		font-weight: 700;
		font-size: 0.8rem;
		padding: 0.35rem 0.65rem;
		border-radius: 6px;
		letter-spacing: 0.5px;
	}
	.dataset-title {
		margin: 0;
		font-size: 1rem;
		font-weight: 600;
		color: #166534;
	}
	.dataset-meta {
		margin: 0.2rem 0 0 0;
		font-size: 0.8rem;
		color: #15803d;
	}
	.download-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		background: #16a34a;
		color: white;
		text-decoration: none;
		padding: 0.6rem 1.1rem;
		border-radius: 8px;
		font-size: 0.9rem;
		font-weight: 600;
		transition: background 0.2s ease, transform 0.1s ease;
	}
	.download-btn:hover {
		background: #15803d;
		transform: translateY(-1px);
	}
</style>
