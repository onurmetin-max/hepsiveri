---
interface Props {
	date: Date;
	includeTime?: boolean;
}

const { date, includeTime = false } = Astro.props;

const dateFormatted = date.toLocaleDateString('tr-TR', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
	timeZone: 'Europe/Istanbul',
});

// Eğer saatsiz (UTC 00:00:00) girilmişse, Google News & Discover standartları gereği
// saati boş bırakmak veya yapay 03:00 basmak yerine standart haber yayın saati (10:00) gösterilir.
// Saatli girilmişse (tüm WordPress arşivimiz gibi) tam kendi gerçek saati gösterilir.
const isMidnightUTC = date.getUTCHours() === 0 && date.getUTCMinutes() === 0 && date.getUTCSeconds() === 0;
const timeFormatted = isMidnightUTC
	? '10:00'
	: date.toLocaleTimeString('tr-TR', {
		hour: '2-digit',
		minute: '2-digit',
		timeZone: 'Europe/Istanbul',
	});
---

<time datetime={date.toISOString()}>
	{includeTime ? `${dateFormatted} - ${timeFormatted}` : dateFormatted}
</time>


