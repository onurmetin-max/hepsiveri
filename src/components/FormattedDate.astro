---
interface Props {
	date: Date;
	includeTime?: boolean;
}

const { date, includeTime = false } = Astro.props;

const dateFormatted = date.toLocaleDateString('tr-TR', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
	timeZone: 'Europe/Istanbul',
});

const timeFormatted = date.toLocaleTimeString('tr-TR', {
	hour: '2-digit',
	minute: '2-digit',
	timeZone: 'Europe/Istanbul',
});

// Saatsiz girilmiş (UTC 00:00:00) tarihlerde Türkiye saatinden kaynaklanan yapay "03:00" saatini gösterme
const isMidnightUTC = date.getUTCHours() === 0 && date.getUTCMinutes() === 0 && date.getUTCSeconds() === 0;
const shouldShowTime = includeTime && !isMidnightUTC;
---

<time datetime={date.toISOString()}>
	{shouldShowTime ? `${dateFormatted} - ${timeFormatted}` : dateFormatted}
</time>


