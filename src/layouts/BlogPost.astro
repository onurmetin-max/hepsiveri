							<div class="author-card-body">
								<div class="author-card-header">
									<div>
										<span class="author-card-role">{authorRole}</span>
										<h4 class="author-card-name">
											<a href={`/yazar/${canonicalAuthorSlug}/`}>{authorDisplayName}</a>
