							</li>
							<li class="factsheet-item">
								<span class="factsheet-label">Açık Veri:</span>
								<span class="factsheet-val" style="color: #15803d;">CSV Mevcut</span>
							</li>
						</ul>
						<a href={datasetUrl} download class="sidebar-download-btn">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
								<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
								<polyline points="7 10 12 15 17 10"></polyline>
								<line x1="12" y1="15" x2="12" y2="3"></line>
							</svg>
							<span>Ham Veri Setini İndir</span>
						</a>
					</div>
				) : (
					<div class="sidebar-widget">
						<h4 class="widget-title">📌 Dosya Hakkında</h4>
						<p style="font-size: 0.88rem; color: #64748b; line-height: 1.5; margin: 0 0 1rem 0;">
							Bu içerik <strong>{category}</strong> kategorisinde yayınlanmıştır. HepsiVeri açık kaynak araştırmaları kapsamında hazırlanmıştır.
