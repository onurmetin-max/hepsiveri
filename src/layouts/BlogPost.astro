				border: 3px solid var(--brand-green);
				box-shadow: 0 2px 8px rgba(31, 154, 119, 0.15);
			}
			.author-card-initials {
				width: 80px;
				height: 80px;
				border-radius: 50%;
				background: #f8fafc;
				border: 3px solid var(--brand-green);
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 1.8rem;
				font-weight: 800;
				color: var(--brand-green);
			}
			.author-card-body {
				flex: 1;
				min-width: 0;
			}
			.author-card-header {
				display: flex;
				justify-content: space-between;
				align-items: flex-start;
				flex-wrap: wrap;
				gap: 0.75rem;
				margin-bottom: 0.5rem;
			}
			.author-card-role {
				display: block;
				font-size: 0.8rem;
				font-weight: 700;
				color: var(--brand-green);
