			</aside>
		</div>

		<Footer />

		<!-- Scroll progress and sticky bar script -->
		<script is:inline>
			const stickyBar = document.getElementById('sticky-bar');
			const progressFill = document.getElementById('reading-fill');

			window.addEventListener('scroll', () => {
				const scrollTop = window.scrollY || document.documentElement.scrollTop;
				const docHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
				const percent = Math.min((scrollTop / docHeight) * 100, 100);

				if (progressFill) {
					progressFill.style.width = percent + '%';
				}

				if (scrollTop > 260) {
					stickyBar?.classList.add('visible');
				} else {
					stickyBar?.classList.remove('visible');
				}
			}, { passive: true });
		</script>
		<!-- Flourish Embed Script for Data Visualizations -->
		<script is:inline src="https://public.flourish.studio/resources/embed.js"></script>

		<!-- Table of Contents ID matching & Scrollspy Script -->
		<script is:inline define:vars={{ serverSlugs: tocHeadings.map(h => h.slug) }}>
			(function() {
				function initToc() {
					const headings = document.querySelectorAll('.article-content h2, .article-content h3');
					if (!headings.length) return;

					// 1. Sunucudan gelen kesin slug'ları sırasıyla başlıklara ata
					headings.forEach((el, index) => {
						if (serverSlugs && serverSlugs[index]) {
							el.id = serverSlugs[index];
						} else if (!el.id) {
							el.id = 'bolum-' + (index + 1);
						}

						// Başlığa fareyle gelindiğinde tıklanabilir bağlantı simgesi (#) ekle
						if (!el.querySelector('.heading-anchor')) {
							const anchor = document.createElement('a');
							anchor.className = 'heading-anchor';
							anchor.href = '#' + el.id;
							anchor.title = 'Bu alt başlığa doğrudan bağlantı';
							anchor.textContent = '#';
							anchor.addEventListener('click', function(e) {
								e.preventDefault();
								scrollToHeading(el.id);
							});
							el.appendChild(anchor);
						}
					});

					// 2. Yumuşak kaydırma fonksiyonu (Üst menü ve okuma çubuğu payı ile)
					function scrollToHeading(targetId) {
						const targetEl = document.getElementById(targetId);
						if (!targetEl) return;
						const headerOffset = 95;
						const elementPosition = targetEl.getBoundingClientRect().top;
						const offsetPosition = elementPosition + window.pageYOffset - headerOffset;

						window.scrollTo({
							top: offsetPosition,
							behavior: 'smooth'
						});

						try {
							history.pushState(null, '', '#' + targetId);
						} catch (e) {}
					}

					// 3. İçindekiler kutusu ve kenar çubuğundaki tüm linklere tıklama dinleyicisi bağla
					document.querySelectorAll('.article-toc-nav a, .toc-list a').forEach(link => {
						link.addEventListener('click', function(e) {
							const href = this.getAttribute('href');
							if (href && href.startsWith('#')) {
								e.preventDefault();
								const targetId = href.substring(1);
								scrollToHeading(targetId);
							}
						});
					});

					// 4. Doğrudan hash URL ile gelinmişse (örn: #suca-suruklenen-cocuklar) oraya kaydır
					if (window.location.hash) {
						const initialId = window.location.hash.substring(1);
						setTimeout(() => scrollToHeading(initialId), 300);
					}

					// 5. İçindekiler kutusu aç/kapa (Gizle / Göster)
					const toggleBtn = document.getElementById('toc-toggle-btn');
					const toggleText = document.getElementById('toc-toggle-text');
					const tocNav = document.getElementById('toc-content-list');
					if (toggleBtn && tocNav && toggleText) {
						toggleBtn.addEventListener('click', () => {
							const isCollapsed = tocNav.classList.toggle('collapsed');
							toggleText.textContent = isCollapsed ? 'Göster' : 'Gizle';
							toggleBtn.setAttribute('aria-expanded', !isCollapsed);
						});
					}

					// 6. Sidebar Scrollspy: Okunan başlığı yeşil renkle vurgula
					const sidebarLinks = document.querySelectorAll('.toc-item-sidebar a');
					if (sidebarLinks.length && 'IntersectionObserver' in window) {
						const observer = new IntersectionObserver((entries) => {
							entries.forEach(entry => {
								if (entry.isIntersecting) {
									const id = entry.target.getAttribute('id');
									sidebarLinks.forEach(link => {
										if (link.getAttribute('href') === '#' + id) {
											link.classList.add('active');
										} else {
											link.classList.remove('active');
										}
									});
								}
							});
						}, {
							rootMargin: '-80px 0px -70% 0px'
						});

						headings.forEach(h => observer.observe(h));
					}
				}

				if (document.readyState === 'loading') {
					document.addEventListener('DOMContentLoaded', initToc);
				} else {
					initToc();
				}
			})();
		</script>

		<!-- Admin Quick Actions (Floating bar, only visible to authenticated admins) -->
		{postSlug && (
			<div id="admin-bar-root" class="admin-float-bar" style="display: none;" aria-label="Yönetici Hızlı Eylemleri">
				<a
					href={`/admin/#/collections/blog/entries/${postSlug}`}
					class="admin-action-btn edit"
					target="_blank"
					rel="noopener"
					title="Bu haberi yönetim panelinde anında düzenle"
				>
					<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
						<path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
						<path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
					</svg>
					<span>Haberi Düzenle</span>
				</a>
				<a
					href="/admin/"
					class="admin-action-btn panel"
					target="_blank"
					rel="noopener"
					title="CMS Yönetim Paneline Git"
				>
					<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
						<rect x="3" y="3" width="7" height="7"></rect>
						<rect x="14" y="3" width="7" height="7"></rect>
						<rect x="14" y="14" width="7" height="7"></rect>
						<rect x="3" y="14" width="7" height="7"></rect>
					</svg>
					<span>Panel</span>
				</a>
			</div>
		)}

		<!-- Admin Authentication Check Script -->
		<script is:inline>
			(function() {
				function checkAdminAuth() {
					try {
						const isAdmin = localStorage.getItem('hepsiveri_admin') === 'true' ||
						                localStorage.getItem('decap-cms-user') !== null ||
						                localStorage.getItem('netlify-cms-user') !== null ||
						                (window.netlifyIdentity && window.netlifyIdentity.currentUser() !== null);
						if (isAdmin) {
							const floatBar = document.getElementById('admin-bar-root');
							if (floatBar) floatBar.style.display = 'flex';
							const inlineBtn = document.getElementById('admin-inline-edit');
							if (inlineBtn) inlineBtn.style.display = 'inline-flex';
						}
					} catch (e) {}
				}

				if (document.readyState === 'loading') {
					document.addEventListener('DOMContentLoaded', checkAdminAuth);
				} else {
					checkAdminAuth();
				}
			})();
		</script>
	</body>
</html>
