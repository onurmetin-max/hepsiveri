			.author-card-links {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				flex-wrap: wrap;
			}
			.author-link-pill {
				font-size: 0.78rem;
				font-weight: 600;
				color: #475569;
				background: #f8fafc;
				border: 1px solid #e2e8f0;
