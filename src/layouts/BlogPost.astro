									<a href={`/yazar/${canonicalAuthorSlug}/`} class="author-name-link">
										<span class="author-name">{authorDisplayName}</span>
									</a>
									<span class="author-subtitle">{authorRole} • HepsiVeri</span>
								</div>
							</div>

							<div class="meta-badges">
