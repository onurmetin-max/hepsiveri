	</head>

	<body>
		<!-- Sticky Top Bar -->
		<aside id="sticky-bar" class="sticky-reader-bar" aria-label="Okuma İlerlemesi">
			<div class="reader-bar-content">
				<a href="/" style="display: inline-flex; align-items: center; text-decoration: none;" aria-label="HepsiVeri Ana Sayfa">
