---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { getReadingTime } from '../../utils/readTime';
import authorsData from '../../data/authors.json';
import fs from 'node:fs';

const trMap: Record<string, string> = { 'ı': 'i', 'ğ': 'g', 'ü': 'u', 'ş': 's', 'ö': 'o', 'ç': 'c', 'İ': 'i' };
function slugify(s: string) {
	let text = s.toLowerCase();
	for (const [k, v] of Object.entries(trMap)) {
		text = text.replaceAll(k, v);
	}
	return text.replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
}

export async function getStaticPaths() {
	const allPosts = await getCollection('blog', ({ data }) => data.status !== 'Taslak');
	const trMap: Record<string, string> = { 'ı': 'i', 'ğ': 'g', 'ü': 'u', 'ş': 's', 'ö': 'o', 'ç': 'c', 'İ': 'i' };
	function slugify(s: string) {
		let text = s.toLowerCase();
		for (const [k, v] of Object.entries(trMap)) {
			text = text.replaceAll(k, v);
		}
		return text.replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
	}

	const authorsMap = new Map<string, { name: string; posts: typeof allPosts }>();

	for (const post of allPosts) {
		const authorName = post.data.author || 'Onur Metin';
		const slug = slugify(authorName);
		if (!authorsMap.has(slug)) {
			authorsMap.set(slug, { name: authorName, posts: [] });
		}
		authorsMap.get(slug)!.posts.push(post);
	}

	const paths = Array.from(authorsMap.entries()).map(([slug, data]) => ({
		params: { author: slug },
		props: {
			authorName: data.name,
			slug,
			posts: data.posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
			redirectTo: null
		},
	}));

	// Eski WordPress yazar linkleri için kalıcı yönlendirmeler (301)
	const legacyRedirects: Record<string, string> = {
		'sevinc': 'sevinc-kocak',
		'bugu': 'bugu-begum-orhan',
		'fatihozcan': 'fatih-ozcan',
		'onurmetin': 'onur-metin',
		'ulasakyol': 'ulas-akyol',
		'meltemsuat': 'meltem-suat'
	};

	for (const [legacy, canonical] of Object.entries(legacyRedirects)) {
		if (!authorsMap.has(legacy)) {
			paths.push({
				params: { author: legacy },
				props: {
					authorName: '',
					slug: legacy,
					posts: [],
					redirectTo: `/yazar/${canonical}/`
				}
			});
		}
	}

	return paths;
}

const { authorName, slug, posts, redirectTo } = Astro.props;
if (redirectTo) {
	return Astro.redirect(redirectTo, 301);
}

const authorsList = Array.isArray(authorsData) ? authorsData : ((authorsData as any).authors || []);
const matchedAuthor = authorsList.find((a: any) => a.id === slug || (a.aliases && a.aliases.includes(slug)));
const profile = matchedAuthor ? {
	name: matchedAuthor.displayName || matchedAuthor.name || authorName,
	role: matchedAuthor.role,
	bio: matchedAuthor.bio,
	social: matchedAuthor.social || undefined,
	website: matchedAuthor.website || undefined
} : {
	name: authorName,
	role: 'Araştırmacı Gazeteci',
	bio: 'HepsiVeri bünyesinde açık veri analizleri ve araştırmacı haber dosyaları hazırlamaktadır.',
	social: undefined,
	website: undefined
};

function getAuthorAvatar(authorSlug: string) {
	const aliases: Record<string, string[]> = {
		'bugu': ['bugu-begum-orhan', 'bugu'],
		'bugu-begum-orhan': ['bugu-begum-orhan', 'bugu'],
		'sevinc': ['sevinc-kocak', 'sevinc'],
		'sevinc-kocak': ['sevinc-kocak', 'sevinc'],
		'fatihozcan': ['fatih-ozcan', 'fatihozcan'],
		'fatih-ozcan': ['fatih-ozcan', 'fatihozcan'],
		'onurmetin': ['onur-metin', 'onurmetin'],
		'onur-metin': ['onur-metin', 'onurmetin'],
		'ulasakyol': ['ulas-akyol', 'ulasakyol'],
		'ulas-akyol': ['ulas-akyol', 'ulasakyol'],
		'meltemsuat': ['meltem-suat', 'meltemsuat'],
		'meltem-suat': ['meltem-suat', 'meltemsuat']
	};

	const slugsToCheck = aliases[authorSlug] || [authorSlug];
	for (const s of slugsToCheck) {
		for (const ext of ['webp', 'jpg', 'jpeg', 'png']) {
			if (fs.existsSync(`public/yazarlar/${s}.${ext}`)) {
				return `/yazarlar/${s}.${ext}`;
			}
		}
	}
	return null;
}
const avatarUrl = getAuthorAvatar(slug);
const displayName = profile.name || authorName;

const siteOrigin = Astro.site?.href || 'https://hepsiveri.com';
const canonicalAuthorUrl = new URL(Astro.url.pathname, siteOrigin).href;
const fullAvatarUrl = avatarUrl ? new URL(avatarUrl, siteOrigin).href : undefined;

const authorPersonSchema = {
	"@context": "https://schema.org",
	"@type": "Person",
	"@id": canonicalAuthorUrl,
	"name": displayName,
	"jobTitle": profile.role || "Araştırmacı Gazeteci",
	"description": profile.bio,
	"image": fullAvatarUrl,
	"url": canonicalAuthorUrl,
	"sameAs": [profile.social, profile.website].filter(Boolean),
	"worksFor": {
		"@type": "NewsMediaOrganization",
		"name": "HepsiVeri",
		"url": "https://hepsiveri.com/",
		"logo": {
			"@type": "ImageObject",
			"url": "https://hepsiveri.com/logo-horizontal.png"
		}
	}
};
---

<!doctype html>
<html lang="tr">
	<head>
		<BaseHead
			title={`${authorName} Haberleri & Analizleri | ${SITE_TITLE}`}
			description={`${authorName} tarafından kaleme alınan tüm veri haberciliği araştırmaları, analizler ve açık veri haberleri.`}
		/>
		<script type="application/ld+json" set:html={JSON.stringify(authorPersonSchema)} />
		<style>
			.author-page-container {
				max-width: 1280px;
				margin: 0 auto;
				padding: 2.5rem 1.5rem 5rem;
			}

			/* Author Profile Header Card */
			.author-profile-hero {
				background: #ffffff;
				border: 1px solid var(--border-subtle);
				border-radius: var(--radius-md);
				padding: 2.5rem;
				margin-bottom: 3rem;
				display: flex;
				gap: 2rem;
				align-items: center;
				box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
			}
			.author-profile-avatar-wrap {
				flex-shrink: 0;
			}
			.profile-avatar-img {
				width: 110px;
				height: 110px;
				border-radius: 50%;
				object-fit: cover;
				border: 3px solid var(--brand-green);
				box-shadow: 0 4px 12px rgba(31, 154, 119, 0.15);
			}
			.profile-avatar-fallback {
				width: 110px;
				height: 110px;
				border-radius: 50%;
				background: #f1f5f9;
				border: 3px solid var(--brand-green);
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 2.6rem;
				font-weight: 800;
				color: var(--brand-green);
			}
			.author-profile-info {
				flex: 1;
			}
			.author-profile-role {
				display: inline-block;
				font-size: 0.85rem;
				font-weight: 700;
				color: var(--brand-green);
				letter-spacing: 0.2px;
				margin-bottom: 0.4rem;
			}
			.author-profile-name {
				font-family: var(--font-display);
				font-size: 2.2rem;
				font-weight: 800;
				color: var(--text-primary);
				margin: 0 0 0.75rem 0;
				letter-spacing: -0.02em;
			}
			.author-profile-bio {
				font-size: 1.05rem;
				color: var(--text-secondary);
				line-height: 1.6;
				margin: 0 0 1.25rem 0;
				max-width: 780px;
			}
			.author-profile-meta {
				display: flex;
				align-items: center;
				gap: 1.25rem;
				font-size: 0.88rem;
				color: #64748b;
				flex-wrap: wrap;
			}
			.author-badge-pill {
				background: #f8fafc;
				padding: 0.35rem 0.75rem;
				border-radius: var(--radius-full);
				border: 1px solid #e2e8f0;
				font-weight: 600;
			}

			/* Section Title */
			.articles-section-header {
				border-bottom: 2px solid var(--text-primary);
				padding-bottom: 0.75rem;
				margin-bottom: 2rem;
				display: flex;
				justify-content: space-between;
				align-items: baseline;
			}
			.articles-section-header h2 {
				font-family: var(--font-display);
				font-size: 1.5rem;
				font-weight: 800;
				color: var(--text-primary);
				margin: 0;
			}

			/* Posts Grid */
			.posts-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 2rem;
			}
			.card {
				background: #ffffff;
				border: 1px solid var(--border-subtle);
				border-radius: var(--radius-md);
				overflow: hidden;
				display: flex;
				flex-direction: column;
				text-decoration: none;
				transition: transform 0.2s ease, box-shadow 0.2s ease;
			}
			.card:hover {
				transform: translateY(-3px);
				box-shadow: 0 10px 20px rgba(0, 0, 0, 0.05);
			}
			.card-thumb-wrap {
				position: relative;
				width: 100%;
				height: 200px;
				overflow: hidden;
				background: #f1f5f9;
			}
			.card-thumb {
				width: 100%;
				height: 100%;
				object-fit: cover;
				transition: transform 0.3s ease;
			}
			.card:hover .card-thumb {
				transform: scale(1.03);
			}
			.card-body {
				padding: 1.25rem;
				display: flex;
				flex-direction: column;
				flex-grow: 1;
			}
			.card-category-badge {
				font-size: 0.78rem;
				font-weight: 700;
				color: var(--brand-green);
				margin-bottom: 0.5rem;
			}
			.card-title {
				font-family: var(--font-display);
				font-size: 1.15rem;
				font-weight: 700;
				line-height: 1.35;
				color: var(--text-primary);
				margin: 0 0 0.6rem 0;
			}
			.card:hover .card-title {
				color: var(--brand-green);
			}
			.card-desc {
				font-size: 0.85rem;
				line-height: 1.5;
				color: var(--text-muted);
				margin: 0 0 1.25rem 0;
				flex-grow: 1;
				display: -webkit-box;
				-webkit-line-clamp: 3;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.card-footer {
				display: flex;
				align-items: center;
				justify-content: space-between;
				font-size: 0.78rem;
				color: #94a3b8;
				border-top: 1px solid #f8fafc;
				padding-top: 0.75rem;
			}

			@media (max-width: 992px) {
				.posts-grid {
					grid-template-columns: repeat(2, 1fr);
				}
				.author-profile-hero {
					flex-direction: column;
					text-align: center;
					gap: 1.25rem;
				}
				.author-profile-bio {
					margin: 0 auto 1.25rem;
				}
				.author-profile-meta {
					justify-content: center;
				}
			}
			@media (max-width: 640px) {
				.posts-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="author-page-container">
			<!-- Author Profile Section -->
			<div class="author-profile-hero">
				<div class="author-profile-avatar-wrap">
					{avatarUrl ? (
						<img src={avatarUrl} alt={displayName} class="profile-avatar-img" />
					) : (
						<div class="profile-avatar-fallback">
							{displayName.charAt(0)}
						</div>
					)}
				</div>
				<div class="author-profile-info">
					<span class="author-profile-role">{profile.role}</span>
					<h1 class="author-profile-name">{displayName}</h1>
					<p class="author-profile-bio">{profile.bio}</p>
					<div class="author-profile-meta">
						<span class="author-badge-pill">📊 {posts.length} Araştırma Dosyası</span>
						{profile.social && (
							<a
								href={profile.social}
								target="_blank"
								rel="noopener noreferrer"
								style="color: var(--brand-green); font-weight: 600; text-decoration: none;"
							>
								X / Twitter ↗
							</a>
						)}
						{profile.website && (
							<a
								href={profile.website}
								target="_blank"
								rel="noopener noreferrer"
								style="color: var(--brand-green); font-weight: 600; text-decoration: none;"
							>
								🌐 Web Sitesi ↗
							</a>
						)}
					</div>
				</div>
			</div>

			<!-- Author's Articles List -->
			<div class="articles-section-header">
				<h2>{displayName} Tarafından Hazırlanan Haberler</h2>
				<span style="font-size: 0.85rem; color: #64748b;">En yeniden eskiye</span>
			</div>

			<div class="posts-grid">
				{posts.map((post) => (
					<a href={`/haber/${post.id}/`} class="card">
						{post.data.heroImage && (
							<div class="card-thumb-wrap">
								<img
									src={typeof post.data.heroImage === 'string' ? post.data.heroImage : post.data.heroImage.src}
									alt={post.data.title}
									class="card-thumb"
									loading="lazy"
								/>
							</div>
						)}
						<div class="card-body">
							<span class="card-category-badge">{post.data.category || 'Genel'}</span>
							<h3 class="card-title">{post.data.title}</h3>
							<p class="card-desc">{post.data.description}</p>
							<div class="card-footer">
								<span><FormattedDate date={post.data.pubDate} /></span>
								<span>{getReadingTime(post)}</span>
							</div>
						</div>
					</a>
				))}
			</div>
		</main>
		<Footer />
	</body>
</html>

