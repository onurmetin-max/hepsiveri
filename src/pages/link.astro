---
import BaseHead from '../components/BaseHead.astro';
import { getCollection } from 'astro:content';

// Yalnızca yayında olan haberleri al, en yeniden eskiye sırala
const allPosts = (await getCollection('blog', ({ data }) => data.status !== 'Taslak')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const latestPost = allPosts[0];
const recentPosts = allPosts.slice(1, 40);

const formatDate = (date: Date) => {
	return new Intl.DateTimeFormat('tr-TR', {
		day: 'numeric',
		month: 'long',
		year: 'numeric',
	}).format(date);
};
---

<!doctype html>
<html lang="tr">
	<head>
		<BaseHead
			title="HepsiVeri - Instagram Bağlantıları & Son Analizler"
			description="HepsiVeri resmi Instagram profili için en son yayınlanan açık veri haberleri, araştırma dosyaları ve analiz bağlantıları."
			image="/logo.png"
		/>
		<style>
			:root {
				--bio-bg: #f8fafc;
				--bio-card-bg: #ffffff;
				--bio-purple: #4c1eb2;
				--bio-purple-hover: #3b1691;
				--bio-purple-light: #f5f3ff;
				--bio-green: #1f9a77;
				--bio-text: #0f172a;
				--bio-muted: #64748b;
				--bio-border: #e2e8f0;
			}

			body {
				background-color: var(--bio-bg);
				color: var(--bio-text);
				font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
				margin: 0;
				padding: 0;
				min-height: 100vh;
				display: flex;
				flex-direction: column;
				align-items: center;
			}

			.bio-wrapper {
				width: 100%;
				max-width: 580px;
				padding: 32px 20px 80px;
				box-sizing: border-box;
				display: flex;
				flex-direction: column;
				gap: 20px;
			}

			/* Profil Başlığı */
			.bio-header {
				text-align: center;
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 12px;
				padding-bottom: 8px;
			}

			.bio-avatar-box {
				width: 88px;
				height: 88px;
				border-radius: 24px;
				background: #ffffff;
				padding: 10px;
				box-shadow: 0 10px 25px -5px rgba(76, 30, 178, 0.12), 0 8px 10px -6px rgba(0, 0, 0, 0.04);
				border: 1px solid var(--bio-border);
				display: flex;
				align-items: center;
				justify-content: center;
				box-sizing: border-box;
			}

			.bio-avatar-img {
				width: 100%;
				height: 100%;
				object-fit: contain;
			}

			.bio-title-row {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 6px;
			}

			.bio-title {
				font-size: 22px;
				font-weight: 800;
				color: var(--bio-text);
				letter-spacing: -0.02em;
				margin: 0;
			}

			.bio-verified-badge {
				color: var(--bio-purple);
				display: flex;
				align-items: center;
			}

			.bio-subtitle {
				font-size: 14.5px;
				color: var(--bio-muted);
				margin: 0;
				max-width: 380px;
				line-height: 1.45;
			}

			/* Sosyal Medya İkonları */
			.bio-socials {
				display: flex;
				align-items: center;
				gap: 10px;
				margin-top: 4px;
			}

			.bio-social-btn {
				display: flex;
				align-items: center;
				justify-content: center;
				width: 40px;
				height: 40px;
				border-radius: 12px;
				background: #ffffff;
				border: 1px solid var(--bio-border);
				color: var(--bio-text);
				text-decoration: none;
				transition: all 0.2s ease;
			}

			.bio-social-btn:hover {
				background: var(--bio-purple-light);
				border-color: var(--bio-purple);
				color: var(--bio-purple);
				transform: translateY(-2px);
			}

			/* Sabit Hızlı Eylemler */
			.bio-actions {
				display: flex;
				flex-direction: column;
				gap: 10px;
			}

			.btn-primary-action {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 10px;
				background: linear-gradient(135deg, var(--bio-purple) 0%, #2e1065 100%);
				color: #ffffff;
				text-decoration: none;
				padding: 15px 20px;
				border-radius: 14px;
				font-size: 15.5px;
				font-weight: 700;
				box-shadow: 0 4px 14px rgba(76, 30, 178, 0.25);
				transition: all 0.2s ease;
			}

			.btn-primary-action:hover {
				transform: translateY(-2px);
				box-shadow: 0 6px 20px rgba(76, 30, 178, 0.35);
			}

			.btn-secondary-action {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 8px;
				background: #ffffff;
				border: 1px solid var(--bio-border);
				color: var(--bio-text);
				text-decoration: none;
				padding: 13px 20px;
				border-radius: 14px;
				font-size: 14.5px;
				font-weight: 600;
				transition: all 0.2s ease;
			}

			.btn-secondary-action:hover {
				border-color: var(--bio-purple);
				background: #fafafa;
				transform: translateY(-1px);
			}

			/* Canlı Arama Kutusu */
			.search-container {
				position: relative;
				margin-top: 4px;
			}

			.search-input {
				width: 100%;
				box-sizing: border-box;
				padding: 12px 16px 12px 42px;
				background: #ffffff;
				border: 1px solid var(--bio-border);
				border-radius: 12px;
				font-size: 14px;
				font-family: inherit;
				outline: none;
				transition: all 0.2s;
			}

			.search-input:focus {
				border-color: var(--bio-purple);
				box-shadow: 0 0 0 3px rgba(76, 30, 178, 0.1);
			}

			.search-icon {
				position: absolute;
				left: 14px;
				top: 50%;
				transform: translateY(-50%);
				color: var(--bio-muted);
				pointer-events: none;
			}

			/* Bölüm Başlığı */
			.section-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 0 4px;
				margin-top: 8px;
			}

			.section-title {
				font-size: 14px;
				font-weight: 800;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				color: var(--bio-muted);
			}

			/* Öne Çıkan En Son Haber */
			.featured-post-card {
				background: #ffffff;
				border: 2px solid rgba(76, 30, 178, 0.2);
				border-radius: 18px;
				overflow: hidden;
				text-decoration: none;
				color: inherit;
				box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
				transition: all 0.2s ease;
				display: flex;
				flex-direction: column;
			}

			.featured-post-card:hover {
				transform: translateY(-3px);
				border-color: var(--bio-purple);
				box-shadow: 0 14px 30px -5px rgba(76, 30, 178, 0.15);
			}

			.featured-badge-bar {
				background: var(--bio-purple-light);
				color: var(--bio-purple);
				font-size: 12px;
				font-weight: 800;
				padding: 8px 16px;
				display: flex;
				align-items: center;
				justify-content: space-between;
				border-bottom: 1px solid rgba(76, 30, 178, 0.1);
			}

			.featured-image-box {
				width: 100%;
				height: 210px;
				background: #f1f5f9;
				overflow: hidden;
				position: relative;
			}

			.featured-img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				transition: transform 0.3s ease;
			}

			.featured-post-card:hover .featured-img {
				transform: scale(1.02);
			}

			.featured-content {
				padding: 18px 20px;
				display: flex;
				flex-direction: column;
				gap: 8px;
			}

			.featured-category {
				font-size: 12px;
				font-weight: 700;
				color: var(--bio-green);
				text-transform: uppercase;
				letter-spacing: 0.04em;
			}

			.featured-title {
				font-size: 17.5px;
				font-weight: 800;
				color: var(--bio-text);
				line-height: 1.4;
				margin: 0;
			}

			.featured-desc {
				font-size: 13.5px;
				color: var(--bio-muted);
				line-height: 1.5;
				margin: 0;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			.featured-cta {
				display: flex;
				align-items: center;
				gap: 6px;
				color: var(--bio-purple);
				font-weight: 700;
				font-size: 13.5px;
				margin-top: 6px;
			}

			/* Haber Listesi */
			.posts-list {
				display: flex;
				flex-direction: column;
				gap: 12px;
			}

			.post-card {
				background: #ffffff;
				border: 1px solid var(--bio-border);
				border-radius: 14px;
				padding: 12px 14px;
				text-decoration: none;
				color: inherit;
				display: flex;
				align-items: center;
				gap: 14px;
				transition: all 0.2s ease;
			}

			.post-card:hover {
				transform: translateY(-2px);
				border-color: var(--bio-purple);
				box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
			}

			.post-thumb-box {
				width: 72px;
				height: 72px;
				border-radius: 10px;
				background: #f1f5f9;
				overflow: hidden;
				flex-shrink: 0;
			}

			.post-thumb-img {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}

			.post-card-content {
				flex: 1;
				min-width: 0;
				display: flex;
				flex-direction: column;
				gap: 4px;
			}

			.post-card-meta {
				display: flex;
				align-items: center;
				gap: 8px;
				font-size: 11.5px;
				color: var(--bio-muted);
			}

			.post-card-cat {
				color: var(--bio-green);
				font-weight: 700;
			}

			.post-card-title {
				font-size: 14px;
				font-weight: 700;
				color: var(--bio-text);
				line-height: 1.35;
				margin: 0;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			.post-card-arrow {
				color: var(--bio-muted);
				transition: transform 0.2s;
				flex-shrink: 0;
			}

			.post-card:hover .post-card-arrow {
				transform: translateX(3px);
				color: var(--bio-purple);
			}

			/* Boş Durum */
			.no-results {
				display: none;
				text-align: center;
				padding: 40px 20px;
				background: #ffffff;
				border-radius: 14px;
				border: 1px dashed var(--bio-border);
				color: var(--bio-muted);
				font-size: 14px;
			}

			/* Footer */
			.bio-footer {
				text-align: center;
				font-size: 13px;
				color: var(--bio-muted);
				margin-top: 20px;
			}

			.bio-footer a {
				color: var(--bio-purple);
				text-decoration: none;
				font-weight: 700;
			}
		</style>
	</head>
	<body>

		<div class="bio-wrapper">

			<!-- Profil Başlığı -->
			<header class="bio-header">
				<div class="bio-avatar-box">
					<img src="/logo.png" alt="HepsiVeri" class="bio-avatar-img" />
				</div>
				<div class="bio-title-row">
					<h1 class="bio-title">HepsiVeri</h1>
					<span class="bio-verified-badge" title="Teyitli Açık Veri Platformu">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
							<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"></path>
						</svg>
					</span>
				</div>
				<p class="bio-subtitle">
					Bağımsız veri gazeteciliği, araştırmacı analizler ve açık veri platformu.
				</p>
				
				<!-- Sosyal Medya İkonları -->
				<div class="bio-socials">
					<a href="https://instagram.com/hepsiveri" target="_blank" rel="noopener" class="bio-social-btn" title="Instagram">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
							<path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
							<line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
						</svg>
					</a>
					<a href="https://x.com/hepsiveri" target="_blank" rel="noopener" class="bio-social-btn" title="X (Twitter)">
						<svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
							<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
						</svg>
					</a>
					<a href="https://hepsiveri.com" class="bio-social-btn" title="Web Sitesi">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<circle cx="12" cy="12" r="10"></circle>
							<line x1="2" y1="12" x2="22" y2="12"></line>
							<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
						</svg>
					</a>
					<a href="mailto:iletisim@hepsiveri.com" class="bio-social-btn" title="E-posta">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
							<polyline points="22,6 12,13 2,6"></polyline>
						</svg>
					</a>
				</div>
			</header>

			<!-- Sabit Eylem Butonları -->
			<div class="bio-actions">
				<a href="https://hepsiveri.com" class="btn-primary-action">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
						<circle cx="12" cy="12" r="10"></circle>
						<line x1="2" y1="12" x2="22" y2="12"></line>
						<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
					</svg>
					<span>hepsiveri.com Ana Sayfasına Git</span>
				</a>
				<a href="https://hepsiveri.com/about" class="btn-secondary-action">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<circle cx="12" cy="12" r="10"></circle>
						<line x1="12" y1="16" x2="12" y2="12"></line>
						<line x1="12" y1="8" x2="12.01" y2="8"></line>
					</svg>
					<span>Hakkımızda & Metodoloji</span>
				</a>
			</div>

			<!-- Canlı Arama -->
			<div class="search-container">
				<svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<circle cx="11" cy="11" r="8"></circle>
					<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
				</svg>
				<input
					type="search"
					id="bio-search"
					class="search-input"
					placeholder="Haber veya veri konusu ara..."
					autocomplete="off"
				/>
			</div>

			<!-- En Son Paylaşılan Analiz (Manşet Kartı) -->
			{latestPost && (
				<div class="featured-wrapper" id="featured-box">
					<div class="section-header">
						<span class="section-title">🔥 En Son Analiz</span>
						<span style="font-size: 12px; color: var(--bio-muted);">{formatDate(latestPost.data.pubDate)}</span>
					</div>
					<a href={`/haber/${latestPost.id}/`} class="featured-post-card">
						<div class="featured-badge-bar">
							<span>SON PAYLAŞILAN DOSYA</span>
							<span>Habere Git →</span>
						</div>
						{latestPost.data.heroImage && (
							<div class="featured-image-box">
								<img
									src={typeof latestPost.data.heroImage === 'string' ? latestPost.data.heroImage : latestPost.data.heroImage.src}
									alt={latestPost.data.title}
									class="featured-img"
									loading="eager"
								/>
							</div>
						)}
						<div class="featured-content">
							<span class="featured-category">{latestPost.data.category}</span>
							<h2 class="featured-title">{latestPost.data.title}</h2>
							{latestPost.data.description && (
								<p class="featured-desc">{latestPost.data.description}</p>
							)}
							<div class="featured-cta">
								<span>Tam metin ve veri tablolarını oku</span>
								<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
									<line x1="5" y1="12" x2="19" y2="12"></line>
									<polyline points="12 5 19 12 12 19"></polyline>
								</svg>
							</div>
						</div>
					</a>
				</div>
			)}

			<!-- Önceki Haberler Listesi -->
			<div class="recent-section">
				<div class="section-header">
					<span class="section-title">📊 Son Analizler & Haberler</span>
				</div>

				<div class="posts-list" id="posts-list">
					{recentPosts.map((post) => (
						<a
							href={`/haber/${post.id}/`}
							class="post-card"
							data-title={post.data.title.toLowerCase()}
							data-cat={post.data.category.toLowerCase()}
							data-desc={(post.data.description || '').toLowerCase()}
						>
							{post.data.heroImage && (
								<div class="post-thumb-box">
									<img
										src={typeof post.data.heroImage === 'string' ? post.data.heroImage : post.data.heroImage.src}
										alt={post.data.title}
										class="post-thumb-img"
										loading="lazy"
									/>
								</div>
							)}
							<div class="post-card-content">
								<div class="post-card-meta">
									<span class="post-card-cat">{post.data.category}</span>
									<span>•</span>
									<span>{formatDate(post.data.pubDate)}</span>
								</div>
								<h3 class="post-card-title">{post.data.title}</h3>
							</div>
							<div class="post-card-arrow">
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<polyline points="9 18 15 12 9 6"></polyline>
								</svg>
							</div>
						</a>
					))}
				</div>

				<div class="no-results" id="no-results">
					🔍 Aradığınız kriterlere uygun haber bulunamadı.
				</div>
			</div>

			<!-- Alt Bilgi -->
			<footer class="bio-footer">
				<p>HepsiVeri Açık Veri Platformu © 2026</p>
				<p><a href="https://hepsiveri.com">hepsiveri.com</a></p>
			</footer>

		</div>

		<!-- Canlı Arama Betiği -->
		<script is:inline>
			const searchInput = document.getElementById('bio-search');
			const postCards = document.querySelectorAll('.post-card');
			const noResults = document.getElementById('no-results');
			const featuredBox = document.getElementById('featured-box');

			searchInput?.addEventListener('input', (e) => {
				const query = e.target.value.toLowerCase().trim();
				let visibleCount = 0;

				if (query) {
					if (featuredBox) featuredBox.style.display = 'none';
				} else {
					if (featuredBox) featuredBox.style.display = 'block';
				}

				postCards.forEach((card) => {
					const title = card.getAttribute('data-title') || '';
					const cat = card.getAttribute('data-cat') || '';
					const desc = card.getAttribute('data-desc') || '';

					if (!query || title.includes(query) || cat.includes(query) || desc.includes(query)) {
						card.style.display = 'flex';
						visibleCount++;
					} else {
						card.style.display = 'none';
					}
				});

				if (noResults) {
					noResults.style.display = visibleCount === 0 && query ? 'block' : 'none';
				}
			});
		</script>

	</body>
</html>
