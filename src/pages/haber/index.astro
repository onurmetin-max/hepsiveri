---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { getReadingTime } from '../../utils/readTime';

const posts = (await getCollection('blog', ({ data }) => data.status !== 'Taslak')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Collect category counts
const categoryCounts = posts.reduce((acc, p) => {
	const cat = p.data.category || 'Genel';
	acc[cat] = (acc[cat] || 0) + 1;
	return acc;
}, {} as Record<string, number>);

const topCategories = Object.entries(categoryCounts)
	.sort((a, b) => b[1] - a[1])
	.slice(0, 10);
---

<!doctype html>
<html lang="tr">
	<head>
		<BaseHead title={`Tüm Dosyalar & Arşiv | ${SITE_TITLE}`} description="HepsiVeri'nin tüm açık veri dosyaları, araştırmaları ve veri görselleştirmeleri arşivi." />
		<style>
			.archive-container {
				max-width: 1280px;
				margin: 0 auto;
				padding: 2.5rem 1.5rem 5rem;
			}

			/* Archive Header */
			.archive-header {
				border-bottom: 2px solid var(--text-primary);
				padding-bottom: 1.5rem;
				margin-bottom: 2rem;
				display: flex;
				justify-content: space-between;
				align-items: flex-end;
				flex-wrap: wrap;
				gap: 1rem;
			}
			.archive-title-group h1 {
				font-family: var(--font-display);
				font-size: 2.4rem;
				font-weight: 800;
				margin: 0 0 0.4rem 0;
				letter-spacing: -0.02em;
				color: var(--text-primary);
			}
			.archive-subtitle {
				font-size: 0.95rem;
				color: var(--text-muted);
				margin: 0;
			}
			.archive-badge {
				background: var(--brand-green-light);
				color: var(--brand-green);
				border: 1px solid var(--brand-green-border);
				padding: 0.4rem 0.85rem;
				border-radius: var(--radius-full);
				font-size: 0.82rem;
				font-weight: 700;
			}

			/* Filter Bar & Search */
			.filter-bar {
				display: flex;
				flex-direction: column;
				gap: 1rem;
				margin-bottom: 2.5rem;
				background: #fafaf9;
				padding: 1.25rem;
				border-radius: var(--radius-md);
				border: 1px solid var(--border-subtle);
			}
			.search-box-row {
				display: flex;
				gap: 1rem;
			}
			.search-input {
				flex-grow: 1;
				padding: 0.65rem 1rem;
				font-size: 0.92rem;
				border: 1px solid var(--border-subtle);
				border-radius: var(--radius-sm);
				background: #ffffff;
				color: var(--text-primary);
				outline: none;
				transition: border-color 0.15s;
			}
			.search-input:focus {
				border-color: var(--brand-green);
			}

			.cat-pills {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				align-items: center;
			}
			.cat-pill {
				background: #ffffff;
				border: 1px solid var(--border-subtle);
				padding: 0.35rem 0.75rem;
				border-radius: var(--radius-full);
				font-size: 0.8rem;
				font-weight: 600;
				color: #475569;
				cursor: pointer;
				transition: all 0.15s ease;
			}
			.cat-pill:hover,
			.cat-pill.active {
				background: var(--brand-green);
				color: #ffffff;
				border-color: var(--brand-green);
			}
			.cat-count {
				font-size: 0.72rem;
				opacity: 0.8;
				margin-left: 0.25rem;
			}

			/* 3-Column Editorial Grid */
			.archive-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 2rem;
			}

			.archive-card {
				background: #ffffff;
				border: 1px solid var(--border-subtle);
				border-radius: var(--radius-sm);
				overflow: hidden;
				display: flex;
				flex-direction: column;
				text-decoration: none;
				transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
			}
			.archive-card:hover {
				transform: translateY(-3px);
				box-shadow: var(--shadow-md);
				border-color: var(--brand-green);
			}

			.card-thumb-wrapper {
				width: 100%;
				height: 200px;
				overflow: hidden;
				background: #f1f5f9;
				position: relative;
			}
			.card-thumb {
				width: 100%;
				height: 100%;
				object-fit: cover;
				transition: transform 0.3s ease;
			}
			.archive-card:hover .card-thumb {
				transform: scale(1.03);
			}

			.card-body {
				padding: 1.25rem;
				display: flex;
				flex-direction: column;
				flex-grow: 1;
			}
			.card-cat {
				font-size: 0.78rem;
				font-weight: 800;
				letter-spacing: 0.2px;
				color: var(--brand-green);
				margin-bottom: 0.45rem;
			}
			.card-title {
				font-family: var(--font-display);
				font-size: 1.15rem;
				font-weight: 700;
				line-height: 1.3;
				color: var(--text-primary);
				margin: 0 0 0.6rem 0;
				transition: color 0.15s;
			}
			.archive-card:hover .card-title {
				color: var(--brand-green);
			}
			.card-desc {
				font-size: 0.85rem;
				line-height: 1.5;
				color: var(--text-muted);
				margin: 0 0 1.25rem 0;
				flex-grow: 1;
				display: -webkit-box;
				-webkit-line-clamp: 3;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.card-footer {
				display: flex;
				align-items: center;
				justify-content: space-between;
				font-size: 0.78rem;
				color: #94a3b8;
				border-top: 1px solid #f8fafc;
				padding-top: 0.75rem;
			}

			.no-results {
				display: none;
				text-align: center;
				padding: 4rem 1rem;
				color: var(--text-muted);
			}

			@media (max-width: 992px) {
				.archive-grid {
					grid-template-columns: repeat(2, 1fr);
				}
			}
			@media (max-width: 640px) {
				.archive-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />

		<main class="archive-container">
			<!-- Header -->
			<div class="archive-header">
				<div class="archive-title-group">
					<h1>Veri ve Araştırma Dosyaları</h1>
					<p class="archive-subtitle">
						Resmi raporlar, kamu verileri ve bağımsız görselleştirmelerle Türkiye ve dünya araştırmaları.
					</p>
				</div>
				<div class="archive-badge">
					📊 Toplam {posts.length} Dosya Yayında
				</div>
			</div>

			<!-- Filter & Search Controls -->
			<div class="filter-bar">
				<div class="search-box-row">
					<input
						type="search"
						id="search-input"
						class="search-input"
						placeholder="Dosya başlığı, veri konusu veya anahtar kelime ile ara..."
					/>
				</div>

				<div class="cat-pills">
					<button class="cat-pill active" data-cat="all">
						Tümü <span class="cat-count">({posts.length})</span>
					</button>
					{topCategories.map(([cat, count]) => (
						<button class="cat-pill" data-cat={cat.toLowerCase()}>
							{cat} <span class="cat-count">({count})</span>
						</button>
					))}
				</div>
			</div>

			<!-- 3-Column Story Grid -->
			<div id="posts-grid" class="archive-grid">
				{posts.map((post) => (
					<article
						class="post-item"
						data-title={post.data.title.toLowerCase()}
						data-desc={post.data.description.toLowerCase()}
						data-cat={(post.data.category || '').toLowerCase()}
					>
						<a href={`/haber/${post.id}/`} class="archive-card">
							{post.data.heroImage && (
								<div class="card-thumb-wrapper">
									<img
										src={post.data.heroImage}
										alt={post.data.title}
										class="card-thumb"
										loading="lazy"
									/>
								</div>
							)}
							<div class="card-body">
								<span class="card-cat">{post.data.category}</span>
								<h2 class="card-title">{post.data.title}</h2>
								<p class="card-desc">{post.data.description}</p>
								<div class="card-footer">
									<span><FormattedDate date={post.data.pubDate} /></span>
									<span>{getReadingTime(post)}</span>
								</div>
							</div>
						</a>
					</article>
				))}
			</div>

			<div id="no-results" class="no-results">
				<h3>Aradığınız kriterlere uygun veri dosyası bulunamadı.</h3>
				<p>Arama teriminizi değiştirebilir veya başka bir kategori seçebilirsiniz.</p>
			</div>
		</main>

		<Footer />

		<!-- Client-Side Instant Filtering Script -->
		<script is:inline>
			const searchInput = document.getElementById('search-input');
			const catPills = document.querySelectorAll('.cat-pill');
			const postItems = document.querySelectorAll('.post-item');
			const noResults = document.getElementById('no-results');

			let activeCategory = 'all';
			let searchFilter = '';

			function applyFilters() {
				let visibleCount = 0;

				postItems.forEach((item) => {
					const title = item.dataset.title || '';
					const desc = item.dataset.desc || '';
					const cat = item.dataset.cat || '';

					const matchesCat = activeCategory === 'all' || cat === activeCategory;
					const matchesSearch = !searchFilter || title.includes(searchFilter) || desc.includes(searchFilter);

					if (matchesCat && matchesSearch) {
						item.style.display = '';
						visibleCount++;
					} else {
						item.style.display = 'none';
					}
				});

				if (noResults) {
					noResults.style.display = visibleCount === 0 ? 'block' : 'none';
				}
			}

			catPills.forEach((pill) => {
				pill.addEventListener('click', () => {
					catPills.forEach((p) => p.classList.remove('active'));
					pill.classList.add('active');
					activeCategory = pill.dataset.cat;
					applyFilters();
				});
			});

			searchInput?.addEventListener('input', (e) => {
				searchFilter = e.target.value.toLowerCase().trim();
				applyFilters();
			});
		</script>
	</body>
</html>
