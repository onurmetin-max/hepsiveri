---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { getReadingTime } from '../../utils/readTime';

export async function getStaticPaths() {
	const allPosts = await getCollection('blog', ({ data }) => data.status !== 'Taslak');
	
	// Map categories to URL friendly slugs
	const trMap: Record<string, string> = { 'ı': 'i', 'ğ': 'g', 'ü': 'u', 'ş': 's', 'ö': 'o', 'ç': 'c', 'İ': 'i' };
	function slugify(s: string) {
		let text = s.toLowerCase();
		for (const [k, v] of Object.entries(trMap)) {
			text = text.replaceAll(k, v);
		}
		return text.replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
	}

	// Group by category slug
	const categoriesMap = new Map<string, { name: string; posts: typeof allPosts }>();

	for (const post of allPosts) {
		let rawCat = post.data.category || 'Genel';
		if (rawCat === 'VeriHaberciliği') rawCat = 'Veri Haberciliği';
		const slug = slugify(rawCat);
		if (!categoriesMap.has(slug)) {
			categoriesMap.set(slug, { name: rawCat, posts: [] });
		}
		categoriesMap.get(slug)!.posts.push(post);
	}

	const paths = Array.from(categoriesMap.entries()).map(([slug, data]) => ({
		params: { category: slug },
		props: {
			categoryName: data.name,
			posts: data.posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
		},
	}));

	// Eski ve bitişik kategori linkleri için alias (verihaberciligi -> veri-haberciligi)
	if (categoriesMap.has('veri-haberciligi') && !categoriesMap.has('verihaberciligi')) {
		const data = categoriesMap.get('veri-haberciligi')!;
		paths.push({
			params: { category: 'verihaberciligi' },
			props: {
				categoryName: 'Veri Haberciliği',
				posts: data.posts,
			},
		});
	}

	return paths;
}

const { categoryName, posts } = Astro.props;
---

<!doctype html>
<html lang="tr">
	<head>
		<BaseHead
			title={`${categoryName} Dosyaları & Haberleri | ${SITE_TITLE}`}
			description={`HepsiVeri ${categoryName} kategorisindeki tüm veri haberciliği araştırmaları ve grafikli analizler.`}
		/>
		<style>
			.cat-container {
				max-width: 1280px;
				margin: 0 auto;
				padding: 2.5rem 1.5rem 5rem;
			}
			.cat-header {
				border-bottom: 2px solid var(--text-primary);
				padding-bottom: 1.5rem;
				margin-bottom: 2.5rem;
				display: flex;
				justify-content: space-between;
				align-items: flex-end;
				flex-wrap: wrap;
				gap: 1rem;
			}
			.cat-header h1 {
				font-family: var(--font-display);
				font-size: 2.4rem;
				font-weight: 800;
				margin: 0 0 0.5rem 0;
				color: var(--text-primary);
				letter-spacing: -0.02em;
			}
			.cat-badge {
				background: var(--brand-green-light);
				color: var(--brand-green);
				border: 1px solid var(--brand-green-border);
				padding: 0.4rem 0.85rem;
				border-radius: var(--radius-full);
				font-size: 0.82rem;
				font-weight: 700;
			}
			.posts-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 2rem;
			}
			.card {
				background: #ffffff;
				border: 1px solid var(--border-subtle);
				border-radius: var(--radius-sm);
				overflow: hidden;
				display: flex;
				flex-direction: column;
				text-decoration: none;
				transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
			}
			.card:hover {
				transform: translateY(-3px);
				box-shadow: var(--shadow-md);
				border-color: var(--brand-green);
			}
			.card-thumb-wrap {
				width: 100%;
				height: 200px;
				background: #f1f5f9;
				overflow: hidden;
			}
			.card-thumb {
				width: 100%;
				height: 100%;
				object-fit: cover;
				transition: transform 0.3s ease;
			}
			.card:hover .card-thumb {
				transform: scale(1.03);
			}
			.card-body {
				padding: 1.25rem;
				display: flex;
				flex-direction: column;
				flex-grow: 1;
			}
			.card-title {
				font-family: var(--font-display);
				font-size: 1.15rem;
				font-weight: 700;
				line-height: 1.3;
				color: var(--text-primary);
				margin: 0 0 0.6rem 0;
			}
			.card:hover .card-title {
				color: var(--brand-green);
			}
			.card-desc {
				font-size: 0.85rem;
				line-height: 1.5;
				color: var(--text-muted);
				margin: 0 0 1.25rem 0;
				flex-grow: 1;
				display: -webkit-box;
				-webkit-line-clamp: 3;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.card-footer {
				display: flex;
				align-items: center;
				justify-content: space-between;
				font-size: 0.78rem;
				color: #94a3b8;
				border-top: 1px solid #f8fafc;
				padding-top: 0.75rem;
			}
			@media (max-width: 992px) {
				.posts-grid {
					grid-template-columns: repeat(2, 1fr);
				}
			}
			@media (max-width: 640px) {
				.posts-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="cat-container">
			<div class="cat-header">
				<div>
					<span style="font-size: 0.8rem; font-weight: 700; color: var(--brand-green);">
						Kategori Dosyaları
					</span>
					<h1>{categoryName}</h1>
				</div>
				<div class="cat-badge">
					📊 Toplam {posts.length} Dosya
				</div>
			</div>

			<div class="posts-grid">
				{posts.map((post) => (
					<a href={`/haber/${post.id}/`} class="card">
						{post.data.heroImage && (
							<div class="card-thumb-wrap">
								<img
									src={post.data.heroImage}
									alt={post.data.title}
									class="card-thumb"
									loading="lazy"
								/>
							</div>
						)}
						<div class="card-body">
							<h2 class="card-title">{post.data.title}</h2>
							<p class="card-desc">{post.data.description}</p>
							<div class="card-footer">
								<span><FormattedDate date={post.data.pubDate} /></span>
								<span>{getReadingTime(post)}</span>
							</div>
						</div>
					</a>
				))}
			</div>
		</main>
		<Footer />
	</body>
</html>
