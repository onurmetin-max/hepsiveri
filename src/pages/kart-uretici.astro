					ctx.lineWidth = 3;
					roundRect(ctx, 70, 620, 940, dBoxHeight, 20, true, true);

					ctx.fillStyle = '#0f172a';
					let dY = 690;
					for (const l of descLines) {
						ctx.fillText(l, 115, dY);
