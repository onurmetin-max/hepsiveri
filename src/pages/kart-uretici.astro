	<!-- Veriler ve Gerçek Zamanlı Canvas Motoru -->
	<script is:inline define:vars={{ postsPayload }}>
		// Resmi Logoyu Önceden Yükle
		const logoImg = new Image();
		logoImg.src = '/logo.png';

		let currentStudioMode = 'data'; // 'data' veya 'concept'
		let totalSlideCount = 4; // 3 veya 4

		// 3 veya 4 Slayt Seçimi
		window.setSlideCount = function(count) {
			totalSlideCount = count;
			const btn4 = document.getElementById('btn-count-4');
			const btn3 = document.getElementById('btn-count-3');
			const wrapS3 = document.getElementById('wrap-slide-3');
			const secS3Data = document.getElementById('sec-s3-data');
			const secS3Concept = document.getElementById('sec-s3-concept');

			if (count === 3) {
				btn4.classList.remove('active');
				btn3.classList.add('active');
				if (wrapS3) wrapS3.classList.add('disabled-slide');
				if (secS3Data) secS3Data.style.opacity = '0.35';
				if (secS3Concept) secS3Concept.style.opacity = '0.35';

				setCounters(['01/03', '02/03', '-', '03/03']);
				document.getElementById('txt-export-btn').innerText = '3 Slaytı İndir (1080x1350)';
			} else {
				btn3.classList.remove('active');
				btn4.classList.add('active');
				if (wrapS3) wrapS3.classList.remove('disabled-slide');
				if (secS3Data) secS3Data.style.opacity = '1';
				if (secS3Concept) secS3Concept.style.opacity = '1';

				setCounters(['01/04', '02/04', '03/04', '04/04']);
				document.getElementById('txt-export-btn').innerText = '4 Slaytı İndir (1080x1350)';
			}
			scheduleRender();
		};

		function setCounters(arr) {
			document.getElementById('inp-counter-1').value = arr[0];
			document.getElementById('inp-counter-2').value = arr[1];
			document.getElementById('inp-counter-2c').value = arr[1];
			document.getElementById('inp-counter-3').value = arr[2];
			document.getElementById('inp-counter-3c').value = arr[2];
			document.getElementById('inp-counter-4').value = arr[3];
		}

		document.getElementById('btn-count-4').addEventListener('click', () => setSlideCount(4));
		document.getElementById('btn-count-3').addEventListener('click', () => setSlideCount(3));

		// Mod Değiştirici (Sayısal vs Kavram)
		window.setStudioMode = function(mode) {
			currentStudioMode = mode;
			const btnData = document.getElementById('btn-mode-data');
			const btnConcept = document.getElementById('btn-mode-concept');
			const secS2Data = document.getElementById('sec-s2-data');
			const secS2Concept = document.getElementById('sec-s2-concept');
			const secS3Data = document.getElementById('sec-s3-data');
			const secS3Concept = document.getElementById('sec-s3-concept');

			const labelS2 = document.getElementById('label-slide-2');
			const labelS3 = document.getElementById('label-slide-3');

			if (mode === 'concept') {
				btnData.classList.remove('active');
				btnConcept.classList.add('active');

				secS2Data.style.display = 'none';
				secS2Concept.style.display = 'block';
				secS3Data.style.display = 'none';
				secS3Concept.style.display = 'block';

				if (labelS2) labelS2.innerText = 'Slayt 2 (Vurucu Alıntı & Tanım)';
				if (labelS3) labelS3.innerText = 'Slayt 3 (Trend ve Odak)';
			} else {
				btnConcept.classList.remove('active');
				btnData.classList.add('active');

				secS2Data.style.display = 'block';
				secS2Concept.style.display = 'none';
				secS3Data.style.display = 'block';
				secS3Concept.style.display = 'none';

				if (labelS2) labelS2.innerText = 'Slayt 2 (Kıyaslama)';
				if (labelS3) labelS3.innerText = 'Slayt 3 (Büyük Rakam)';
			}
			scheduleRender();
		};

		document.getElementById('btn-mode-data').addEventListener('click', () => setStudioMode('data'));
		document.getElementById('btn-mode-concept').addEventListener('click', () => setStudioMode('concept'));

		// Sayaç Senkronizasyonu
		document.getElementById('inp-counter-2').addEventListener('input', (e) => {
			document.getElementById('inp-counter-2c').value = e.target.value;
		});
		document.getElementById('inp-counter-2c').addEventListener('input', (e) => {
			document.getElementById('inp-counter-2').value = e.target.value;
		});
		document.getElementById('inp-counter-3').addEventListener('input', (e) => {
			document.getElementById('inp-counter-3c').value = e.target.value;
		});
		document.getElementById('inp-counter-3c').addEventListener('input', (e) => {
			document.getElementById('inp-counter-3').value = e.target.value;
		});

		// Gelişmiş Karakter Sayaçları ve Kapasite Rehberi
		const charTrackers = [
			{ inp: 'inp-cat', cnt: 'cnt-cat', ideal: 25, hard: 35 },
			{ inp: 'inp-title', cnt: 'cnt-title', ideal: 75, hard: 100 },
			{ inp: 'inp-desc', cnt: 'cnt-desc', ideal: 130, hard: 175 },
			{ inp: 'inp-comp-title', cnt: 'cnt-comp-title', ideal: 35, hard: 50 },
			{ inp: 'inp-comp-note', cnt: 'cnt-comp-note', ideal: 80, hard: 110 },
			{ inp: 'inp-concept-title', cnt: 'cnt-concept-title', ideal: 35, hard: 50 },
			{ inp: 'inp-concept-quote', cnt: 'cnt-concept-quote', ideal: 140, hard: 210 },
			{ inp: 'inp-concept-context', cnt: 'cnt-concept-context', ideal: 90, hard: 130 },
			{ inp: 'inp-stat-desc', cnt: 'cnt-stat-desc', ideal: 120, hard: 165 },
			{ inp: 'inp-concept-stat-desc', cnt: 'cnt-concept-stat-desc', ideal: 120, hard: 165 },
			{ inp: 'inp-sum-1', cnt: 'cnt-sum-1', ideal: 115, hard: 165 },
			{ inp: 'inp-sum-2', cnt: 'cnt-sum-2', ideal: 115, hard: 165 },
			{ inp: 'inp-sum-3', cnt: 'cnt-sum-3', ideal: 115, hard: 165 },
			{ inp: 'inp-source', cnt: 'cnt-source', ideal: 55, hard: 75 }
		];

		function updateCounter(tracker) {
			const inp = document.getElementById(tracker.inp);
			const cnt = document.getElementById(tracker.cnt);
			if (!inp || !cnt) return;
			const len = (inp.value || '').length;
			if (len === 0) {
				cnt.innerText = `0 / ${tracker.ideal} kr. (Boş)`;
				cnt.className = 'char-count';
			} else if (len < Math.round(tracker.ideal * 0.45)) {
				cnt.innerText = `${len} / ${tracker.ideal} kr. (Kısa)`;
				cnt.className = 'char-count';
			} else if (len <= tracker.ideal) {
				cnt.innerText = `${len} / ${tracker.ideal} kr. (İdeal)`;
				cnt.className = 'char-count ideal-limit';
			} else if (len <= tracker.hard) {
				cnt.innerText = `${len} / ${tracker.hard} kr. (Dolu)`;
				cnt.className = 'char-count near-limit';
			} else {
				cnt.innerText = `${len} / ${tracker.hard} kr. (Çok Uzun)`;
				cnt.className = 'char-count over-limit';
			}
		}

		function updateAllCounters() {
			charTrackers.forEach(updateCounter);
		}

		// Sidebar içindeki her türlü değişiklikte önizlemeyi ve sayaçları yenile
		document.querySelector('.editor-sidebar').addEventListener('input', () => {
			updateAllCounters();
			scheduleRender();
		});

		// Haber Seçildiğinde Otomatik Doldur
		const selector = document.getElementById('post-selector');
		selector.addEventListener('change', (e) => {
			const idx = e.target.value;
			if (idx === '') return;
			const post = postsPayload[idx];
			if (!post) return;

			// Kapak
			document.getElementById('inp-cat').value = post.category;
			document.getElementById('inp-title').value = post.title;
			document.getElementById('inp-desc').value = post.desc || '';

			// Sayısal Mod Alanları
			document.getElementById('inp-comp-title').value = post.compTitle;
			document.getElementById('inp-comp-l-label').value = post.compLLabel;
			document.getElementById('inp-comp-l-val').value = post.compLVal;
			document.getElementById('inp-comp-r-label').value = post.compRLabel;
			document.getElementById('inp-comp-r-val').value = post.compRVal;
			document.getElementById('inp-comp-note').value = post.compNote;

			document.getElementById('inp-stat-eyebrow').value = post.statEyebrow;
			document.getElementById('inp-stat-number').value = post.statNumber;
			document.getElementById('inp-stat-desc').value = post.statDesc;

			// Kavram Modu Alanları
			document.getElementById('inp-concept-title').value = post.conceptTitle;
			document.getElementById('inp-concept-quote').value = post.conceptQuote;
			document.getElementById('inp-concept-context').value = post.conceptContext;
			document.getElementById('inp-concept-stat-eyebrow').value = post.conceptStatEyebrow;
			document.getElementById('inp-concept-stat-num').value = post.conceptStatNumber;
			document.getElementById('inp-concept-stat-desc').value = post.conceptStatDesc;

			// Özet
			document.getElementById('inp-sum-1').value = post.sum1;
			document.getElementById('inp-sum-2').value = post.sum2;
			document.getElementById('inp-sum-3').value = post.sum3;
			document.getElementById('inp-source').value = post.source;

			// Otomatik Modu Uygula
			setStudioMode(post.recommendedMode || 'data');
			updateAllCounters();
			scheduleRender();
		});

		// Metni Satırlara Bölen Yardımcı
		function getWrappedLines(ctx, text, maxWidth) {
			const words = (text || '').trim().split(/\s+/);
			const lines = [];
			let currentLine = '';

			for (let i = 0; i < words.length; i++) {
				const testLine = currentLine ? currentLine + ' ' + words[i] : words[i];
				const metrics = ctx.measureText(testLine);
				if (metrics.width > maxWidth && currentLine) {
					lines.push(currentLine);
					currentLine = words[i];
				} else {
					currentLine = testLine;
				}
			}
			if (currentLine) lines.push(currentLine);
			return lines;
		}

		// Yuvarlatılmış Kutu Çizimi
		function roundRect(ctx, x, y, width, height, radius, fill, stroke) {
			ctx.beginPath();
			ctx.moveTo(x + radius, y);
			ctx.lineTo(x + width - radius, y);
			ctx.quadraticCurveTo(x + width, y, x + width, y + radius);
			ctx.lineTo(x + width, y + height - radius);
			ctx.quadraticCurveTo(x + width, y + height, x + width - radius, y + height);
			ctx.lineTo(x + radius, y + height);
			ctx.quadraticCurveTo(x, y + height, x, y + height - radius);
			ctx.lineTo(x, y + radius);
			ctx.quadraticCurveTo(x, y, x + radius, y);
			ctx.closePath();
			if (fill) ctx.fill();
			if (stroke) ctx.stroke();
		}

		function getCounter(slideNum) {
			if (slideNum === 1) return document.getElementById('inp-counter-1').value || '01/04';
			if (slideNum === 2) return (currentStudioMode === 'concept' ? document.getElementById('inp-counter-2c').value : document.getElementById('inp-counter-2').value) || '02/04';
			if (slideNum === 3) return (currentStudioMode === 'concept' ? document.getElementById('inp-counter-3c').value : document.getElementById('inp-counter-3').value) || '03/04';
			if (slideNum === 4) return document.getElementById('inp-counter-4').value || '04/04';
			return `0${slideNum}/04`;
		}

		// 1080x1350 Piksel Gerçek Zamanlı Kanvas Çizici
		function renderSlideToCanvas(slideNum) {
			const canvas = document.getElementById(`preview-canvas-${slideNum}`);
			if (!canvas) return;
			const ctx = canvas.getContext('2d');
			const w = 1080;
			const h = 1350;

			// 1. Zemin Rengi (#FBFBFA)
			ctx.fillStyle = '#fbfbfa';
			ctx.fillRect(0, 0, w, h);

			// 2. İnce Dış Çerçeve
			ctx.strokeStyle = '#e2e8f0';
			ctx.lineWidth = 3;
			ctx.strokeRect(30, 30, w - 60, h - 60);

			// 3. Logo Çizimi (sol:70, üst:65)
			if (logoImg.complete && logoImg.naturalHeight > 0) {
				const logoH = 48;
				const logoW = Math.round(logoH * (logoImg.naturalWidth / logoImg.naturalHeight));
				ctx.drawImage(logoImg, 70, 65, logoW, logoH);
			} else {
				ctx.font = '800 34px "Plus Jakarta Sans", sans-serif';
				ctx.fillStyle = '#4c1eb2';
				ctx.fillText('Hepsi', 70, 105);
				const hepsiWidth = ctx.measureText('Hepsi').width;
				ctx.fillStyle = '#1f9a77';
				ctx.fillText('Veri', 70 + hepsiWidth, 105);
			}

			// Slayt Numarası (Sağ Üst: Kullanıcının girdiği sayaç metni)
			const counterText = getCounter(slideNum);
			ctx.font = '700 28px "JetBrains Mono", monospace';
			ctx.fillStyle = '#64748b';
			ctx.textAlign = 'right';
			ctx.fillText(counterText, w - 70, 105);
			ctx.textAlign = 'left';

			// Alt Footer Çizgisi (Tabana Sabitli: 1250px)
			ctx.strokeStyle = '#e2e8f0';
			ctx.lineWidth = 2;
			ctx.beginPath();
			ctx.moveTo(70, 1250);
			ctx.lineTo(w - 70, 1250);
			ctx.stroke();

			ctx.font = '600 26px "Plus Jakarta Sans", sans-serif';
			ctx.fillStyle = '#64748b';
			const isLastSlide = (slideNum === 4 || (totalSlideCount === 3 && slideNum === 4));
			ctx.fillText(isLastSlide ? 'Kaydet & Paylaş' : 'Kaydırın ➔', 70, 1295);
			ctx.textAlign = 'right';
			ctx.fillText('hepsiveri.com', w - 70, 1295);
			ctx.textAlign = 'left';

			// --- Slayt İçerik Çizimleri ---
			if (slideNum === 1) {
				// Slayt 1: Kapak (Dikeyde Dengeli Yerleşim)
				const cat = (document.getElementById('inp-cat').value || '').trim();
				if (cat) {
					ctx.font = '700 24px "Plus Jakarta Sans", sans-serif';
					const catMetrics = ctx.measureText(cat);
					const catPillWidth = catMetrics.width + 36;
					ctx.fillStyle = 'rgba(31, 154, 119, 0.1)';
					roundRect(ctx, 70, 205, catPillWidth, 48, 10, true, false);
					ctx.fillStyle = '#1f9a77';
					ctx.fillText(cat, 88, 238);
				}

				const title = (document.getElementById('inp-title').value || '').trim();
				const desc = (document.getElementById('inp-desc').value || '').trim();

				let titleFontSize = 64;
				let titleLineHeight = 84;
				if (title.length > 85) {
					titleFontSize = 52;
					titleLineHeight = 70;
				} else if (title.length > 60) {
					titleFontSize = 58;
					titleLineHeight = 78;
				}

				ctx.font = `800 ${titleFontSize}px "Plus Jakarta Sans", sans-serif`;
				const titleLines = getWrappedLines(ctx, title, 940);
				const titleHeight = titleLines.length * titleLineHeight;

				ctx.font = '500 36px "Plus Jakarta Sans", sans-serif';
				const descLines = getWrappedLines(ctx, desc, 940);
				const descHeight = descLines.length * 54;

				// Başlık ve Açıklamayı 290px ile 1200px arasında zarifçe ortala
				const totalBlockHeight = titleHeight + 50 + descHeight;
				const titleStartY = 290 + Math.max(30, (890 - totalBlockHeight) / 2);

				ctx.fillStyle = '#0f172a';
				ctx.font = `800 ${titleFontSize}px "Plus Jakarta Sans", sans-serif`;
				let curY = titleStartY;
				for (const line of titleLines) {
					ctx.fillText(line, 70, curY);
					curY += titleLineHeight;
				}

				curY += 45;
				ctx.fillStyle = '#334155';
				ctx.font = '500 36px "Plus Jakarta Sans", sans-serif';
				for (const line of descLines) {
					ctx.fillText(line, 70, curY);
					curY += 54;
				}

			} else if (slideNum === 2) {
				if (currentStudioMode === 'concept') {
					// Slayt 2: Kavram & Alıntı Kartı (Dinamik Ölçümlü & Taşmayan)
					const conceptTitle = (document.getElementById('inp-concept-title').value || '').trim();
					ctx.fillStyle = '#4c1eb2';
					ctx.font = '800 48px "Plus Jakarta Sans", sans-serif';
					const titleLines = getWrappedLines(ctx, conceptTitle, 940);
					let tY = 230;
					for (const l of titleLines) {
						ctx.fillText(l, 70, tY);
						tY += 60;
					}

					// Alıntı Metnini Ölç
					const quoteRaw = (document.getElementById('inp-concept-quote').value || '').replace(/^[“"]|[”"]$/g, '').trim();
					const fullQuote = `“${quoteRaw}”`;
					
					let qFontSize = 40;
					let qLineHeight = 58;
					if (fullQuote.length > 200) { qFontSize = 32; qLineHeight = 46; }
					else if (fullQuote.length > 130) { qFontSize = 36; qLineHeight = 52; }

					ctx.font = `500 italic ${qFontSize}px "Newsreader", Georgia, serif`;
					const quoteLines = getWrappedLines(ctx, fullQuote, 840);
					
					const quoteBoxTop = tY + 30;
					const quoteTextHeight = quoteLines.length * qLineHeight;
					const quoteBoxHeight = Math.max(quoteTextHeight + 90, 280);

					// 1. Alıntı Kutusu
					ctx.fillStyle = '#ffffff';
					ctx.strokeStyle = '#e2e8f0';
					ctx.lineWidth = 3;
					roundRect(ctx, 70, quoteBoxTop, 940, quoteBoxHeight, 20, true, true);

					// Sol Mor Şerit
					ctx.fillStyle = '#4c1eb2';
					roundRect(ctx, 70, quoteBoxTop, 12, quoteBoxHeight, 6, true, false);

					ctx.fillStyle = '#0f172a';
					let qY = quoteBoxTop + 65;
					for (const line of quoteLines) {
						ctx.fillText(line, 115, qY);
						qY += qLineHeight;
					}

					// 2. Alt Bağlam Notu Kutusu
					const contextText = (document.getElementById('inp-concept-context').value || '').trim();
					ctx.font = '600 30px "Plus Jakarta Sans", sans-serif';
					const contextLines = getWrappedLines(ctx, contextText, 860);
					const contextBoxHeight = Math.max(contextLines.length * 44 + 50, 130);
					const contextBoxTop = Math.min(quoteBoxTop + quoteBoxHeight + 35, 1220 - contextBoxHeight);

					ctx.fillStyle = '#f8fafc';
					ctx.strokeStyle = '#cbd5e1';
					ctx.lineWidth = 2;
					roundRect(ctx, 70, contextBoxTop, 940, contextBoxHeight, 16, true, true);

					ctx.fillStyle = '#334155';
					let cY = contextBoxTop + 50;
					for (const line of contextLines) {
						ctx.fillText(line, 105, cY);
						cY += 44;
					}

				} else {
					// Slayt 2: Sayısal Kıyaslama
					const compTitle = (document.getElementById('inp-comp-title').value || '').trim();
					ctx.fillStyle = '#0f172a';
					ctx.font = '800 52px "Plus Jakarta Sans", sans-serif';
					const titleLines = getWrappedLines(ctx, compTitle, 940);
					let tY = 230;
					for (const l of titleLines) {
						ctx.fillText(l, 70, tY);
						tY += 68;
					}

					const boxTop = tY + 40;
					// Sol Kutu
					ctx.fillStyle = '#ffffff';
					ctx.strokeStyle = '#cbd5e1';
					ctx.lineWidth = 3;
					roundRect(ctx, 70, boxTop, 445, 380, 20, true, true);

					ctx.fillStyle = '#64748b';
					ctx.font = '600 28px "Plus Jakarta Sans", sans-serif';
					ctx.textAlign = 'center';
					ctx.fillText(document.getElementById('inp-comp-l-label').value || '', 292, boxTop + 90);

					ctx.fillStyle = '#0f172a';
					const lVal = document.getElementById('inp-comp-l-val').value || '';
					ctx.font = lVal.length > 7 ? '800 68px "JetBrains Mono", monospace' : '800 84px "JetBrains Mono", monospace';
					ctx.fillText(lVal, 292, boxTop + 240);

					// Sağ Kutu (Vurgulu)
					ctx.fillStyle = '#f0fdf4';
					ctx.strokeStyle = '#1f9a77';
					ctx.lineWidth = 4;
					roundRect(ctx, 565, boxTop, 445, 380, 20, true, true);

					ctx.fillStyle = '#1f9a77';
					ctx.font = '700 28px "Plus Jakarta Sans", sans-serif';
					ctx.fillText(document.getElementById('inp-comp-r-label').value || '', 787, boxTop + 90);

					ctx.fillStyle = '#1f9a77';
					const rVal = document.getElementById('inp-comp-r-val').value || '';
					ctx.font = rVal.length > 7 ? '800 68px "JetBrains Mono", monospace' : '800 84px "JetBrains Mono", monospace';
					ctx.fillText(rVal, 787, boxTop + 240);
					ctx.textAlign = 'left';

					// Fark Notu
					const noteText = (document.getElementById('inp-comp-note').value || '').trim();
					ctx.font = '600 32px "Plus Jakarta Sans", sans-serif';
					const noteLines = getWrappedLines(ctx, noteText, 860);
					const noteBoxHeight = Math.max(noteLines.length * 48 + 50, 140);
					const noteBoxTop = boxTop + 420;

					ctx.fillStyle = '#ffffff';
					ctx.strokeStyle = '#e2e8f0';
					ctx.lineWidth = 2;
					roundRect(ctx, 70, noteBoxTop, 940, noteBoxHeight, 16, true, true);

					ctx.fillStyle = '#334155';
					let nY = noteBoxTop + 50;
					for (const l of noteLines) {
						ctx.fillText(l, 105, nY);
						nY += 48;
					}
				}

			} else if (slideNum === 3) {
				if (currentStudioMode === 'concept') {
					// Slayt 3: Kavram Trend & Odak
					ctx.textAlign = 'center';
					const eyebrow = (document.getElementById('inp-concept-stat-eyebrow').value || '').trim();
					ctx.fillStyle = '#4c1eb2';
					ctx.font = '700 32px "Plus Jakarta Sans", sans-serif';
					ctx.fillText(eyebrow, 540, 310);

					const statVal = (document.getElementById('inp-concept-stat-num').value || '').trim();
					ctx.fillStyle = '#1f9a77';
					if (statVal.length > 8) {
						ctx.font = '800 95px "JetBrains Mono", monospace';
					} else {
						ctx.font = '800 145px "JetBrains Mono", monospace';
					}
					ctx.fillText(statVal, 540, 490);
					ctx.textAlign = 'left';

					const descText = (document.getElementById('inp-concept-stat-desc').value || '').trim();
					ctx.font = '500 36px "Plus Jakarta Sans", sans-serif';
					const descLines = getWrappedLines(ctx, descText, 840);
					const dBoxHeight = Math.max(descLines.length * 52 + 70, 250);

					ctx.fillStyle = '#ffffff';
					ctx.strokeStyle = '#e2e8f0';
					ctx.lineWidth = 3;
					roundRect(ctx, 70, 600, 940, dBoxHeight, 20, true, true);

					ctx.fillStyle = '#0f172a';
					let dY = 670;
					for (const l of descLines) {
						ctx.fillText(l, 115, dY);
						dY += 52;
					}

				} else {
					// Slayt 3: Sayısal Büyük Rakam
					ctx.textAlign = 'center';
					ctx.fillStyle = '#1f9a77';
					ctx.font = '700 34px "Plus Jakarta Sans", sans-serif';
					ctx.fillText((document.getElementById('inp-stat-eyebrow').value || '').trim(), 540, 310);

					ctx.fillStyle = '#4c1eb2';
					const statVal = (document.getElementById('inp-stat-number').value || '').trim();
					if (statVal.length > 8) {
						ctx.font = '800 100px "JetBrains Mono", monospace';
					} else {
						ctx.font = '800 150px "JetBrains Mono", monospace';
					}
					ctx.fillText(statVal, 540, 490);
					ctx.textAlign = 'left';

					const descText = (document.getElementById('inp-stat-desc').value || '').trim();
					ctx.font = '500 36px "Plus Jakarta Sans", sans-serif';
					const descLines = getWrappedLines(ctx, descText, 840);
					const dBoxHeight = Math.max(descLines.length * 52 + 70, 250);

					ctx.fillStyle = '#ffffff';
					ctx.strokeStyle = '#e2e8f0';
					ctx.lineWidth = 3;
					roundRect(ctx, 70, 600, 940, dBoxHeight, 20, true, true);

					ctx.fillStyle = '#0f172a';
					let dY = 670;
					for (const l of descLines) {
						ctx.fillText(l, 115, dY);
						dY += 52;
					}
				}

			} else if (slideNum === 4) {
				// Slayt 4: Özet ve Temel Çıkarımlar (DENGELİ VE KUSURSUZ DAĞILIM)
				ctx.fillStyle = '#0f172a';
				ctx.font = '800 52px "Plus Jakarta Sans", sans-serif';
				ctx.fillText('Özet ve Temel Çıkarımlar', 70, 230);

				const m1 = (document.getElementById('inp-sum-1').value || '').trim();
				const m2 = (document.getElementById('inp-sum-2').value || '').trim();
				const m3 = (document.getElementById('inp-sum-3').value || '').trim();
				const bullets = [m1, m2, m3].filter(Boolean);

				// Alt Bloklar (Tabana Sabitli)
				const ctaTop = 1115;
				const srcTop = 1010;

				// Metin yoğunluğuna göre dinamik font ve satır aralığı
				const totalChars = bullets.reduce((sum, b) => sum + b.length, 0);

				let bFontSize = 36;
				let bLineHeight = 52;
				if (totalChars > 360) {
					bFontSize = 31;
					bLineHeight = 44;
				} else if (totalChars > 230) {
					bFontSize = 34;
					bLineHeight = 48;
				} else {
					bFontSize = 38;
					bLineHeight = 56;
				}

				ctx.font = `500 ${bFontSize}px "Plus Jakarta Sans", sans-serif`;
				// x=70 ikon, x=125 metin başlangıcı -> maxWidth: 880
				const wrappedBullets = bullets.map(text => getWrappedLines(ctx, text, 880));
				const totalLines = wrappedBullets.reduce((acc, lines) => acc + lines.length, 0);
				const totalTextHeight = totalLines * bLineHeight;

				// y=260 ile y=srcTop-20 (990) arasındaki kullanılabilir alan: 730px
				const availableZone = srcTop - 20 - 260;
				const remainingSpace = Math.max(0, availableZone - totalTextHeight);

				// Maddeler arası boşluk ve başlangıç konumu
				const bulletCount = Math.max(bullets.length, 1);
				const bulletGap = Math.max(26, Math.min(75, remainingSpace / (bulletCount + 0.5)));
				const startY = 270 + Math.max(15, (remainingSpace - (bulletCount - 1) * bulletGap) / 2);

				let curY = startY;
				for (let i = 0; i < bullets.length; i++) {
					const lines = wrappedBullets[i];

					// Yeşil Kurumsal Onay İşareti (✓)
					ctx.fillStyle = '#1f9a77';
					ctx.font = `800 ${bFontSize + 2}px "Plus Jakarta Sans", sans-serif`;
					ctx.fillText('✓', 70, curY);

					// Metin Satırları (x=125'ten hizalı asılı girinti)
					ctx.fillStyle = '#334155';
					ctx.font = `500 ${bFontSize}px "Plus Jakarta Sans", sans-serif`;
					for (const line of lines) {
						ctx.fillText(line, 125, curY);
						curY += bLineHeight;
					}
					curY += bulletGap;
				}

				// Kaynak Kutusu
				ctx.fillStyle = '#ffffff';
				ctx.strokeStyle = '#cbd5e1';
				ctx.lineWidth = 2;
				roundRect(ctx, 70, srcTop, 940, 80, 12, true, true);
				ctx.fillStyle = '#64748b';
				ctx.font = '600 28px "Plus Jakarta Sans", sans-serif';
				const srcVal = (document.getElementById('inp-source').value || 'Kaynak: HepsiVeri Araştırma & Açık Veri').trim();
				ctx.fillText(srcVal, 105, srcTop + 50);

				// CTA Butonu
				ctx.fillStyle = '#1f9a77';
				roundRect(ctx, 70, ctaTop, 940, 105, 16, true, false);
				ctx.fillStyle = '#ffffff';
				ctx.font = '700 32px "Plus Jakarta Sans", sans-serif';
				ctx.textAlign = 'center';
				ctx.fillText('Haberin tamamı ve açık kaynaklar için link profilde', 540, ctaTop + 64);
				ctx.textAlign = 'left';
			}
		}

		// Tüm Slaytları Ekrana Çizen Fonksiyon
		function renderAllSlides() {
			renderSlideToCanvas(1);
			renderSlideToCanvas(2);
			renderSlideToCanvas(3);
			renderSlideToCanvas(4);
		}

		// Yumuşak ve Kesintisiz Render Zamanlayıcı
		let renderRaf = null;
		function scheduleRender() {
			if (renderRaf) cancelAnimationFrame(renderRaf);
			renderRaf = requestAnimationFrame(() => {
				renderAllSlides();
			});
		}

		// Tekli PNG İndirme
		window.downloadSingle = function(slideNum) {
			const canvas = document.getElementById(`preview-canvas-${slideNum}`);
			if (!canvas) return;
			const a = document.createElement('a');
			a.download = `hepsiveri-slayt-0${slideNum}.png`;
			a.href = canvas.toDataURL('image/png');
			a.click();
		};

		// Tüm Slaytları İndir (3 veya 4)
		document.getElementById('btn-export-all').addEventListener('click', async () => {
			const slidesToDownload = totalSlideCount === 3 ? [1, 2, 4] : [1, 2, 3, 4];
			for (const s of slidesToDownload) {
				downloadSingle(s);
				await new Promise(r => setTimeout(r, 400));
			}
		});

		// Başlangıç Yüklemeleri
		logoImg.onload = () => {
			scheduleRender();
		};

		if (document.fonts && document.fonts.ready) {
			document.fonts.ready.then(() => {
				scheduleRender();
			});
		} else {
			setTimeout(scheduleRender, 350);
		}

		// İlk çalıştırma
		updateAllCounters();
		scheduleRender();
	</script>
</body>
</html>
