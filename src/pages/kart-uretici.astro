					}

				} else {
					// Slayt 3: Sayısal Büyük Rakam
					ctx.textAlign = 'center';
					ctx.fillStyle = '#1f9a77';
					ctx.font = '700 34px "Plus Jakarta Sans", sans-serif';
					ctx.fillText(document.getElementById('inp-stat-eyebrow').value, 540, 310);

					ctx.fillStyle = '#4c1eb2';
					const statVal = document.getElementById('inp-stat-number').value || '';
					if (statVal.length > 8) {
						ctx.font = '800 100px "JetBrains Mono", monospace';
					} else {
						ctx.font = '800 150px "JetBrains Mono", monospace';
					}
					ctx.fillText(statVal, 540, 490);
					ctx.textAlign = 'left';

					const descText = document.getElementById('inp-stat-desc').value;
					ctx.font = '500 36px "Plus Jakarta Sans", sans-serif';
					const descLines = getWrappedLines(ctx, descText, 840);
					const dBoxHeight = Math.max(descLines.length * 52 + 70, 260);

					ctx.fillStyle = '#ffffff';
					ctx.strokeStyle = '#e2e8f0';
					ctx.lineWidth = 3;
					roundRect(ctx, 70, 620, 940, dBoxHeight, 20, true, true);

					ctx.fillStyle = '#0f172a';
					let dY = 690;
					for (const l of descLines) {
						ctx.fillText(l, 115, dY);
						dY += 52;
					}
				}

			} else if (slideNum === 4) {
				// Slayt 4: Özet ve Çıkarımlar
				ctx.fillStyle = '#0f172a';
				ctx.font = '800 52px "Plus Jakarta Sans", sans-serif';
				ctx.fillText('Özet ve Temel Çıkarımlar', 70, 230);

				const m1 = '• ' + document.getElementById('inp-sum-1').value;
				const m2 = '• ' + document.getElementById('inp-sum-2').value;
				const m3 = '• ' + document.getElementById('inp-sum-3').value;

				ctx.fillStyle = '#334155';
				ctx.font = '500 32px "Plus Jakarta Sans", sans-serif';
				
				let curY = 320;
				for (const item of [m1, m2, m3]) {
					const lines = getWrappedLines(ctx, item, 940);
					for (const line of lines) {
						ctx.fillText(line, 70, curY);
						curY += 46;
					}
					curY += 24;
				}

				// Kaynak
				const srcY = Math.max(curY + 20, 860);
				ctx.fillStyle = '#ffffff';
				ctx.strokeStyle = '#cbd5e1';
				ctx.lineWidth = 2;
				roundRect(ctx, 70, srcY, 940, 100, 12, true, true);
				ctx.fillStyle = '#64748b';
				ctx.font = '600 28px "Plus Jakarta Sans", sans-serif';
				ctx.fillText(document.getElementById('inp-source').value, 100, srcY + 60);

				// CTA Buton
				const ctaY = srcY + 130;
				ctx.fillStyle = '#1f9a77';
				roundRect(ctx, 70, ctaY, 940, 115, 16, true, false);
				ctx.fillStyle = '#ffffff';
				ctx.font = '700 32px "Plus Jakarta Sans", sans-serif';
				ctx.textAlign = 'center';
				ctx.fillText('Haberin tamamı ve açık kaynaklar için link profilde', 540, ctaY + 70);
				ctx.textAlign = 'left';
			}

			return canvas.toDataURL('image/png');
		}

		// Yuvarlatılmış Kutu Çizimi
		function roundRect(ctx, x, y, width, height, radius, fill, stroke) {
			ctx.beginPath();
			ctx.moveTo(x + radius, y);
			ctx.lineTo(x + width - radius, y);
			ctx.quadraticCurveTo(x + width, y, x + width, y + radius);
			ctx.lineTo(x + width, y + height - radius);
			ctx.quadraticCurveTo(x + width, y + height, x + width - radius, y + height);
			ctx.lineTo(x + radius, y + height);
			ctx.quadraticCurveTo(x, y + height, x, y + height - radius);
			ctx.lineTo(x, y + radius);
			ctx.quadraticCurveTo(x, y, x + radius, y);
			ctx.closePath();
			if (fill) ctx.fill();
			if (stroke) ctx.stroke();
		}

		// Tekli İndirme
		window.downloadSingle = function(slideNum) {
			const dataUrl = renderSlideToCanvas(slideNum);
			const a = document.createElement('a');
			a.download = `hepsiveri-slayt-0${slideNum}.png`;
			a.href = dataUrl;
			a.click();
		};

		// Tüm Slaytları İndir (3 veya 4)
		document.getElementById('btn-export-all').addEventListener('click', async () => {
			if (totalSlideCount === 3) {
				// Slayt 1, Slayt 2 ve Son Slayt (Slayt 4)
				downloadSingle(1);
				await new Promise(r => setTimeout(r, 350));
				downloadSingle(2);
				await new Promise(r => setTimeout(r, 350));
				downloadSingle(4);
			} else {
				for (let i = 1; i <= 4; i++) {
					downloadSingle(i);
					await new Promise(r => setTimeout(r, 350));
				}
			}
		});
	</script>
</body>
</html>
