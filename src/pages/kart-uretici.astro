<!DOCTYPE html>
<html lang="tr">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta name="robots" content="noindex, nofollow">
	<title>HepsiVeri - Instagram Kart & Görsel Üreticisi</title>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
	
	<style>
		:root {
			--font-main: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
			--font-mono: 'JetBrains Mono', monospace;
			--bg-canvas: #f4f4f5;
			--card-bg: #fbfbfa;
			--brand-purple: #4c1eb2;
			--brand-green: #1f9a77;
			--text-primary: #0f172a;
			--text-secondary: #334155;
			--text-muted: #64748b;
			--border: #e2e8f0;
		}

		* { box-sizing: border-box; margin: 0; padding: 0; }

		body {
			font-family: var(--font-main);
			background-color: var(--bg-canvas);
			color: var(--text-primary);
			line-height: 1.5;
			padding-bottom: 80px;
		}

		/* Üst Bar */
		.app-header {
			background: #ffffff;
			border-bottom: 1px solid var(--border);
			padding: 16px 24px;
			display: flex;
			justify-content: space-between;
			align-items: center;
			position: sticky;
			top: 0;
			z-index: 50;
		}

		.app-brand {
			display: flex;
			align-items: center;
			gap: 12px;
		}

		.app-logo-text {
			font-size: 20px;
			font-weight: 800;
			letter-spacing: -0.5px;
		}
		.app-logo-text .p1 { color: var(--brand-purple); }
		.app-logo-text .p2 { color: var(--brand-green); }

		.app-badge {
			background: #f0fdf4;
			color: var(--brand-green);
			border: 1px solid #bbf7d0;
			font-size: 11px;
			font-weight: 700;
			padding: 4px 8px;
			border-radius: 6px;
			text-transform: uppercase;
		}

		.header-actions {
			display: flex;
			gap: 12px;
		}

		.btn-download-all {
			background: var(--brand-green);
			color: #ffffff;
			border: none;
			padding: 10px 20px;
			border-radius: 8px;
			font-weight: 700;
			font-size: 14px;
			cursor: pointer;
			display: flex;
			align-items: center;
			gap: 8px;
			transition: background 0.2s;
		}
		.btn-download-all:hover { background: #15803d; }

		/* Ana Düzen: Sol Panel (Form) - Sağ Panel (Önizleme) */
		.studio-container {
			max-width: 1600px;
			margin: 24px auto;
			padding: 0 24px;
			display: grid;
			grid-template-columns: 460px 1fr;
			gap: 32px;
			align-items: start;
		}

		/* Sol Form Alanı */
		.editor-sidebar {
			background: #ffffff;
			border: 1px solid var(--border);
			border-radius: 12px;
			padding: 24px;
			max-height: calc(100vh - 120px);
			overflow-y: auto;
		}

		.sidebar-section {
			margin-bottom: 24px;
			padding-bottom: 20px;
			border-bottom: 1px solid var(--border);
		}
		.sidebar-section:last-child { border-bottom: none; margin-bottom: 0; }

		.section-title {
			font-size: 14px;
			font-weight: 800;
			color: var(--text-primary);
			margin-bottom: 12px;
			display: flex;
			align-items: center;
			gap: 8px;
			text-transform: uppercase;
			letter-spacing: 0.5px;
		}

		.form-group {
			margin-bottom: 14px;
		}
		.form-label {
			display: block;
			font-size: 12px;
			font-weight: 600;
			color: var(--text-secondary);
			margin-bottom: 6px;
		}

		.form-select, .form-input, .form-textarea {
			width: 100%;
			padding: 10px 12px;
			border: 1px solid var(--border);
			border-radius: 8px;
			font-family: inherit;
			font-size: 13px;
			color: var(--text-primary);
			background: #ffffff;
			outline: none;
			transition: border-color 0.2s;
		}
		.form-select:focus, .form-input:focus, .form-textarea:focus {
			border-color: var(--brand-purple);
			box-shadow: 0 0 0 2px rgba(76, 30, 178, 0.1);
		}

		.form-row {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 12px;
		}

		/* Sağ Canlı Önizleme Alanı */
		.preview-area {
			display: flex;
			flex-direction: column;
			gap: 20px;
		}

		.preview-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
			gap: 20px;
		}

		/* Tekil Kart Slayt Önizlemesi (4:5 Aspect Ratio) */
		.slide-wrapper {
			background: #ffffff;
			border: 1px solid var(--border);
			border-radius: 12px;
			padding: 12px;
			box-shadow: 0 2px 8px rgba(0,0,0,0.04);
		}

		.slide-header {
			display: flex;
			justify-content: space-between;
			align-items: center;
			margin-bottom: 10px;
			font-size: 12px;
			font-weight: 700;
			color: var(--text-muted);
		}

		.btn-save-slide {
			background: #ffffff;
			border: 1px solid var(--border);
			padding: 4px 10px;
			border-radius: 6px;
			font-size: 11px;
			font-weight: 600;
			cursor: pointer;
			transition: all 0.2s;
		}
		.btn-save-slide:hover {
			background: var(--brand-purple);
			color: #ffffff;
			border-color: var(--brand-purple);
		}

		/* 1080x1350 px Kart Kanvası */
		.slide-card {
			width: 100%;
			aspect-ratio: 4 / 5;
			background: var(--card-bg);
			border: 1px solid rgba(0,0,0,0.08);
			border-radius: 8px;
			padding: 24px;
			display: flex;
			flex-direction: column;
			justify-content: space-between;
			position: relative;
			overflow: hidden;
			box-shadow: inset 0 0 0 1px rgba(255,255,255,0.6);
		}

		/* Kart İçi Tipografi */
		.card-topbar {
			display: flex;
			justify-content: space-between;
			align-items: center;
		}

		.card-logo {
			font-size: 16px;
			font-weight: 800;
			letter-spacing: -0.5px;
		}
		.card-logo .p1 { color: var(--brand-purple); }
		.card-logo .p2 { color: var(--brand-green); }

		.card-tag {
			background: rgba(31, 154, 119, 0.1);
			color: var(--brand-green);
			font-size: 11px;
			font-weight: 700;
			padding: 3px 8px;
			border-radius: 4px;
			text-transform: uppercase;
		}

		.card-counter {
			font-family: var(--font-mono);
			font-size: 11px;
			font-weight: 700;
			color: var(--text-muted);
		}

		/* Slayt 1: Kapak */
		.cover-center {
			margin: auto 0;
		}
		.cover-headline {
			font-size: 20px;
			font-weight: 800;
			color: var(--text-primary);
			line-height: 1.3;
			margin-bottom: 12px;
		}
		.cover-sub {
			font-size: 13px;
			color: var(--text-secondary);
			line-height: 1.5;
		}

		.card-footer {
			display: flex;
			justify-content: space-between;
			align-items: center;
			font-size: 11px;
			font-weight: 600;
			color: var(--text-muted);
			border-top: 1px solid rgba(0,0,0,0.06);
			padding-top: 10px;
		}

		/* Slayt 2: Karşılaştırma */
		.compare-title {
			font-size: 15px;
			font-weight: 800;
			color: var(--text-primary);
			margin-bottom: 12px;
		}
		.compare-boxes {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 10px;
			margin-bottom: 12px;
		}
		.stat-box {
			background: #ffffff;
			border: 1px solid var(--border);
			border-radius: 8px;
			padding: 12px;
			text-align: center;
		}
		.stat-box.highlight {
			border-color: var(--brand-green);
			background: #f0fdf4;
		}
		.stat-label {
			font-size: 11px;
			font-weight: 600;
			color: var(--text-muted);
			margin-bottom: 4px;
		}
		.stat-val {
			font-size: 26px;
			font-weight: 800;
			color: var(--text-primary);
			font-family: var(--font-mono);
		}
		.stat-box.highlight .stat-val {
			color: var(--brand-green);
		}
		.compare-note {
			font-size: 12px;
			color: var(--text-secondary);
			background: #ffffff;
			padding: 8px 10px;
			border-radius: 6px;
			border: 1px solid var(--border);
		}

		/* Slayt 3: Dev Rakam */
		.big-stat-wrap {
			text-align: center;
			margin: auto 0;
		}
		.big-stat-eyebrow {
			font-size: 12px;
			font-weight: 800;
			color: var(--brand-purple);
			text-transform: uppercase;
			margin-bottom: 8px;
		}
		.big-stat-number {
			font-size: 54px;
			font-weight: 800;
			color: var(--brand-purple);
			font-family: var(--font-mono);
			line-height: 1;
			margin-bottom: 12px;
		}
		.big-stat-desc {
			font-size: 12px;
			color: var(--text-secondary);
			line-height: 1.5;
			background: #ffffff;
			padding: 10px;
			border-radius: 6px;
			border: 1px solid var(--border);
		}

		/* Slayt 4: Özet & CTA */
		.summary-title {
			font-size: 15px;
			font-weight: 800;
			color: var(--text-primary);
			margin-bottom: 10px;
		}
		.summary-list {
			list-style: none;
			margin-bottom: 12px;
		}
		.summary-item {
			font-size: 12px;
			color: var(--text-secondary);
			padding: 6px 0;
			border-bottom: 1px dashed var(--border);
			display: flex;
			gap: 6px;
		}
		.summary-item:last-child { border-bottom: none; }
		.summary-bullet { color: var(--brand-green); font-weight: 800; }

		.source-box {
			background: #ffffff;
			border: 1px solid var(--border);
			padding: 8px 10px;
			border-radius: 6px;
			font-size: 10px;
			color: var(--text-muted);
			margin-bottom: 10px;
		}

		.cta-banner {
			background: var(--brand-green);
			color: #ffffff;
			padding: 8px 10px;
			border-radius: 6px;
			font-size: 11px;
			font-weight: 700;
			text-align: center;
		}

		/* Gizli Yüksek Çözünürlüklü Export Canvas'ı */
		#export-canvas { display: none; }
	</style>
</head>
