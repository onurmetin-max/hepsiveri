					ctx.fillText(statVal, 540, 490);
					ctx.textAlign = 'left';

					// Açıklama Kutusu
					const descText = document.getElementById('inp-concept-stat-desc').value;
					ctx.font = '500 36px "Plus Jakarta Sans", sans-serif';
					const descLines = getWrappedLines(ctx, descText, 840);
					const dBoxHeight = Math.max(descLines.length * 52 + 70, 260);

					ctx.fillStyle = '#ffffff';
