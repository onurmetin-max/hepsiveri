	<!-- Veriler ve Script -->
	<script is:inline define:vars={{ postsPayload }}>
		// Resmi Logoyu Önceden Yükle
		const logoImg = new Image();
		logoImg.src = '/logo.png';

		let currentStudioMode = 'data'; // 'data' veya 'concept'

		// Mod Değiştirici
		window.setStudioMode = function(mode) {
			currentStudioMode = mode;
			const btnData = document.getElementById('btn-mode-data');
			const btnConcept = document.getElementById('btn-mode-concept');
			const secS2Data = document.getElementById('sec-s2-data');
			const secS2Concept = document.getElementById('sec-s2-concept');
			const secS3Data = document.getElementById('sec-s3-data');
			const secS3Concept = document.getElementById('sec-s3-concept');

			const viewS2Data = document.getElementById('view-s2-data');
			const viewS2Concept = document.getElementById('view-s2-concept');
			const viewS3Data = document.getElementById('view-s3-data');
			const viewS3Concept = document.getElementById('view-s3-concept');

			const labelS2 = document.getElementById('label-slide-2');
			const labelS3 = document.getElementById('label-slide-3');

			if (mode === 'concept') {
				btnData.classList.remove('active');
				btnConcept.classList.add('active');

				secS2Data.style.display = 'none';
				secS2Concept.style.display = 'block';
				secS3Data.style.display = 'none';
				secS3Concept.style.display = 'block';

				viewS2Data.style.display = 'none';
				viewS2Concept.style.display = 'flex';
				viewS3Data.style.display = 'none';
				viewS3Concept.style.display = 'block';

				if (labelS2) labelS2.innerText = 'Slayt 2 (Vurucu Alıntı & Tanım)';
				if (labelS3) labelS3.innerText = 'Slayt 3 (Trend ve Odak)';
			} else {
				btnConcept.classList.remove('active');
				btnData.classList.add('active');

				secS2Data.style.display = 'block';
				secS2Concept.style.display = 'none';
				secS3Data.style.display = 'block';
				secS3Concept.style.display = 'none';

				viewS2Data.style.display = 'block';
				viewS2Concept.style.display = 'none';
				viewS3Data.style.display = 'block';
				viewS3Concept.style.display = 'none';

				if (labelS2) labelS2.innerText = 'Slayt 2 (Kıyaslama)';
				if (labelS3) labelS3.innerText = 'Slayt 3 (Büyük Rakam)';
			}
		};

		document.getElementById('btn-mode-data').addEventListener('click', () => setStudioMode('data'));
		document.getElementById('btn-mode-concept').addEventListener('click', () => setStudioMode('concept'));

		// Form - Önizleme Canlı Bağlantısı
		const bindInput = (inpId, viewId, isQuote = false) => {
			const inp = document.getElementById(inpId);
			const view = document.getElementById(viewId);
			if (inp && view) {
				inp.addEventListener('input', () => {
					view.innerText = isQuote ? `“${inp.value.replace(/^[“"]|[”"]$/g, '')}”` : inp.value;
				});
			}
		};

		// Ortak Alanlar
		bindInput('inp-cat', 'view-cat');
		bindInput('inp-title', 'view-title');
		bindInput('inp-desc', 'view-desc');
		bindInput('inp-sum-1', 'view-sum-1');
		bindInput('inp-sum-2', 'view-sum-2');
		bindInput('inp-sum-3', 'view-sum-3');
		bindInput('inp-source', 'view-source');

		// Sayısal Mod Alanları
		bindInput('inp-comp-title', 'view-comp-title');
		bindInput('inp-comp-l-label', 'view-comp-l-label');
		bindInput('inp-comp-l-val', 'view-comp-l-val');
		bindInput('inp-comp-r-label', 'view-comp-r-label');
		bindInput('inp-comp-r-val', 'view-comp-r-val');
		bindInput('inp-comp-note', 'view-comp-note');
		bindInput('inp-stat-eyebrow', 'view-stat-eyebrow');
		bindInput('inp-stat-number', 'view-stat-number');
		bindInput('inp-stat-desc', 'view-stat-desc');

		// Kavram Modu Alanları
		bindInput('inp-concept-title', 'view-concept-title');
		bindInput('inp-concept-quote', 'view-concept-quote', true);
		bindInput('inp-concept-context', 'view-concept-context');
		bindInput('inp-concept-stat-eyebrow', 'view-concept-stat-eyebrow');
		bindInput('inp-concept-stat-num', 'view-concept-stat-num');
		bindInput('inp-concept-stat-desc', 'view-concept-stat-desc');

		// Haber Seçildiğinde Otomatik Doldur ve Modu Ayarla
		const selector = document.getElementById('post-selector');
		selector.addEventListener('change', (e) => {
			const idx = e.target.value;
			if (idx === '') return;
			const post = postsPayload[idx];
			if (!post) return;

			// Kapak
			document.getElementById('inp-cat').value = post.category;
			document.getElementById('inp-title').value = post.title;
			document.getElementById('inp-desc').value = post.desc || '';

			// Sayısal Mod Alanları
			document.getElementById('inp-comp-title').value = post.compTitle;
			document.getElementById('inp-comp-l-label').value = post.compLLabel;
			document.getElementById('inp-comp-l-val').value = post.compLVal;
			document.getElementById('inp-comp-r-label').value = post.compRLabel;
			document.getElementById('inp-comp-r-val').value = post.compRVal;
			document.getElementById('inp-comp-note').value = post.compNote;

			document.getElementById('inp-stat-eyebrow').value = post.statEyebrow;
			document.getElementById('inp-stat-number').value = post.statNumber;
			document.getElementById('inp-stat-desc').value = post.statDesc;

			// Kavram Modu Alanları
			document.getElementById('inp-concept-title').value = post.conceptTitle;
			document.getElementById('inp-concept-quote').value = post.conceptQuote;
			document.getElementById('inp-concept-context').value = post.conceptContext;
			document.getElementById('inp-concept-stat-eyebrow').value = post.conceptStatEyebrow;
			document.getElementById('inp-concept-stat-num').value = post.conceptStatNumber;
			document.getElementById('inp-concept-stat-desc').value = post.conceptStatDesc;

			// Özet
			document.getElementById('inp-sum-1').value = post.sum1;
			document.getElementById('inp-sum-2').value = post.sum2;
			document.getElementById('inp-sum-3').value = post.sum3;
			document.getElementById('inp-source').value = post.source;

			// Otomatik Modu Uygula
			setStudioMode(post.recommendedMode || 'data');

			// Önizleme elemanlarını tetikle
			const inputs = document.querySelectorAll('.form-input, .form-textarea');
			inputs.forEach(i => i.dispatchEvent(new Event('input')));
		});

		// 1080x1350 Piksel Yüksek Çözünürlüklü Canvas Çizici
		function renderSlideToCanvas(slideNum) {
			const canvas = document.getElementById('export-canvas');
			const ctx = canvas.getContext('2d');
			const w = 1080;
			const h = 1350;

			// 1. Zemin Rengi (#FBFBFA)
			ctx.fillStyle = '#fbfbfa';
			ctx.fillRect(0, 0, w, h);

			// 2. İnce Dış Çerçeve
			ctx.strokeStyle = '#e2e8f0';
			ctx.lineWidth = 4;
			ctx.strokeRect(40, 40, w - 80, h - 80);

			// 3. Logo Çizimi
			if (logoImg.complete && logoImg.naturalHeight > 0) {
				const logoH = 76;
				const logoW = Math.round(logoH * (logoImg.naturalWidth / logoImg.naturalHeight));
				ctx.drawImage(logoImg, 90, 95, logoW, logoH);
			} else {
				ctx.font = '800 48px "Plus Jakarta Sans", sans-serif';
				ctx.fillStyle = '#4c1eb2';
				ctx.fillText('Hepsi', 90, 145);
				const hepsiWidth = ctx.measureText('Hepsi').width;
				ctx.fillStyle = '#1f9a77';
				ctx.fillText('Veri', 90 + hepsiWidth, 145);
			}

			// Slayt Numarası (Sağ Üst)
			ctx.font = '700 32px "JetBrains Mono", monospace';
			ctx.fillStyle = '#64748b';
			ctx.textAlign = 'right';
			ctx.fillText(`0${slideNum}/04`, w - 90, 145);
			ctx.textAlign = 'left';

			// Alt Footer Çizgisi
			ctx.strokeStyle = '#e2e8f0';
			ctx.lineWidth = 2;
			ctx.beginPath();
			ctx.moveTo(90, h - 140);
			ctx.lineTo(w - 90, h - 140);
			ctx.stroke();

			ctx.font = '600 28px "Plus Jakarta Sans", sans-serif';
			ctx.fillStyle = '#64748b';
			ctx.fillText(slideNum === 4 ? 'Kaydet & Paylaş' : 'Kaydırın ➔', 90, h - 90);
			ctx.textAlign = 'right';
			ctx.fillText('hepsiveri.com', w - 90, h - 90);
			ctx.textAlign = 'left';

			// Slayt İçerik Çizimleri
			if (slideNum === 1) {
				// Slayt 1: Kapak
				const cat = document.getElementById('inp-cat').value;
				ctx.fillStyle = '#1f9a77';
				ctx.font = '700 28px "Plus Jakarta Sans", sans-serif';
				ctx.fillText(cat, 90, 280);

				const title = document.getElementById('inp-title').value;
				ctx.fillStyle = '#0f172a';
				ctx.font = '800 64px "Plus Jakarta Sans", sans-serif';
				const nextY = drawWrappedText(ctx, title, 90, 410, 900, 84);

				const desc = document.getElementById('inp-desc').value;
				ctx.fillStyle = '#334155';
				ctx.font = '500 36px "Plus Jakarta Sans", sans-serif';
				const spotY = Math.max(nextY + 40, 840);
				drawWrappedText(ctx, desc, 90, spotY, 900, 54);

			} else if (slideNum === 2) {
				if (currentStudioMode === 'concept') {
					// Slayt 2: Kavram & Alıntı Kartı Çizimi
					const conceptTitle = document.getElementById('inp-concept-title').value;
					ctx.fillStyle = '#4c1eb2';
					ctx.font = '800 48px "Plus Jakarta Sans", sans-serif';
					drawWrappedText(ctx, conceptTitle, 90, 290, 900, 64);

					// Dekoratif Tırnak İşareti
					ctx.font = '700 130px Georgia, serif';
					ctx.fillStyle = 'rgba(76, 30, 178, 0.2)';
					ctx.fillText('“', 90, 420);

					// Vurgulu Alıntı Kutusu
					ctx.fillStyle = '#ffffff';
					ctx.strokeStyle = '#e2e8f0';
					ctx.lineWidth = 3;
					roundRect(ctx, 90, 430, 900, 430, 20, true, true);

					// Sol Mor Şerit
					ctx.fillStyle = '#4c1eb2';
					roundRect(ctx, 90, 430, 14, 430, 6, true, false);

					// Alıntı Metni
					const quoteRaw = document.getElementById('inp-concept-quote').value.replace(/^[“"]|[”"]$/g, '');
					ctx.fillStyle = '#0f172a';
					ctx.font = '500 italic 42px "Newsreader", Georgia, serif';
					drawWrappedText(ctx, `“${quoteRaw}”`, 140, 530, 800, 62);

					// Alt Bağlam Notu Kutusu
					ctx.fillStyle = '#f8fafc';
					ctx.strokeStyle = '#cbd5e1';
					ctx.lineWidth = 2;
					roundRect(ctx, 90, 900, 900, 160, 16, true, true);

					const contextText = document.getElementById('inp-concept-context').value;
					ctx.fillStyle = '#334155';
					ctx.font = '600 32px "Plus Jakarta Sans", sans-serif';
					drawWrappedText(ctx, contextText, 130, 975, 820, 48);

				} else {
					// Slayt 2: Sayısal Kıyaslama Çizimi
					const compTitle = document.getElementById('inp-comp-title').value;
					ctx.fillStyle = '#0f172a';
					ctx.font = '800 52px "Plus Jakarta Sans", sans-serif';
					drawWrappedText(ctx, compTitle, 90, 300, 900, 70);

					// Sol Kutu
					ctx.fillStyle = '#ffffff';
					ctx.strokeStyle = '#cbd5e1';
					ctx.lineWidth = 3;
					roundRect(ctx, 90, 480, 420, 360, 20, true, true);

					ctx.fillStyle = '#64748b';
					ctx.font = '600 28px "Plus Jakarta Sans", sans-serif';
					ctx.textAlign = 'center';
					ctx.fillText(document.getElementById('inp-comp-l-label').value, 300, 565);

					ctx.fillStyle = '#0f172a';
					const lVal = document.getElementById('inp-comp-l-val').value || '';
					ctx.font = lVal.length > 7 ? '800 68px "JetBrains Mono", monospace' : '800 84px "JetBrains Mono", monospace';
					ctx.fillText(lVal, 300, 715);

					// Sağ Kutu (Vurgulu)
					ctx.fillStyle = '#f0fdf4';
					ctx.strokeStyle = '#1f9a77';
					ctx.lineWidth = 4;
					roundRect(ctx, 570, 480, 420, 360, 20, true, true);

					ctx.fillStyle = '#1f9a77';
					ctx.font = '700 28px "Plus Jakarta Sans", sans-serif';
					ctx.fillText(document.getElementById('inp-comp-r-label').value, 780, 565);

					ctx.fillStyle = '#1f9a77';
					const rVal = document.getElementById('inp-comp-r-val').value || '';
					ctx.font = rVal.length > 7 ? '800 68px "JetBrains Mono", monospace' : '800 84px "JetBrains Mono", monospace';
					ctx.fillText(rVal, 780, 715);
					ctx.textAlign = 'left';

					// Fark Notu
					ctx.fillStyle = '#ffffff';
					ctx.strokeStyle = '#e2e8f0';
					roundRect(ctx, 90, 900, 900, 160, 16, true, true);

					ctx.fillStyle = '#334155';
					ctx.font = '600 34px "Plus Jakarta Sans", sans-serif';
					drawWrappedText(ctx, document.getElementById('inp-comp-note').value, 130, 995, 820, 50);
				}

			} else if (slideNum === 3) {
				if (currentStudioMode === 'concept') {
					// Slayt 3: Kavram & Trend Çizimi
					ctx.textAlign = 'center';
					const eyebrow = document.getElementById('inp-concept-stat-eyebrow').value;
					ctx.fillStyle = '#4c1eb2';
					ctx.font = '700 32px "Plus Jakarta Sans", sans-serif';
					ctx.fillText(eyebrow, 540, 350);

					const statVal = document.getElementById('inp-concept-stat-num').value || '';
					ctx.fillStyle = '#1f9a77';
					if (statVal.length > 8) {
						ctx.font = '800 100px "JetBrains Mono", monospace';
					} else {
						ctx.font = '800 150px "JetBrains Mono", monospace';
					}
					ctx.fillText(statVal, 540, 540);
					ctx.textAlign = 'left';

					// Açıklama Kutusu
					ctx.fillStyle = '#ffffff';
					ctx.strokeStyle = '#e2e8f0';
					ctx.lineWidth = 3;
					roundRect(ctx, 90, 680, 900, 360, 20, true, true);

					ctx.fillStyle = '#0f172a';
					ctx.font = '500 38px "Plus Jakarta Sans", sans-serif';
					const descText = document.getElementById('inp-concept-stat-desc').value;
					drawWrappedText(ctx, descText, 140, 790, 800, 60);

				} else {
					// Slayt 3: Sayısal Büyük Rakam Çizimi
					ctx.textAlign = 'center';
					ctx.fillStyle = '#1f9a77';
					ctx.font = '700 34px "Plus Jakarta Sans", sans-serif';
					ctx.fillText(document.getElementById('inp-stat-eyebrow').value, 540, 360);

					ctx.fillStyle = '#4c1eb2';
					const statVal = document.getElementById('inp-stat-number').value || '';
					if (statVal.length > 8) {
						ctx.font = '800 110px "JetBrains Mono", monospace';
					} else {
						ctx.font = '800 160px "JetBrains Mono", monospace';
					}
					ctx.fillText(statVal, 540, 560);
					ctx.textAlign = 'left';

					ctx.fillStyle = '#ffffff';
					ctx.strokeStyle = '#e2e8f0';
					ctx.lineWidth = 3;
					roundRect(ctx, 90, 700, 900, 340, 20, true, true);

					ctx.fillStyle = '#0f172a';
					ctx.font = '500 38px "Plus Jakarta Sans", sans-serif';
					drawWrappedText(ctx, document.getElementById('inp-stat-desc').value, 140, 800, 800, 60);
				}

			} else if (slideNum === 4) {
				// Slayt 4: Özet ve Çıkarımlar
				ctx.fillStyle = '#0f172a';
				ctx.font = '800 52px "Plus Jakarta Sans", sans-serif';
				ctx.fillText('Özet ve Temel Çıkarımlar', 90, 280);

				const m1 = '• ' + document.getElementById('inp-sum-1').value;
				const m2 = '• ' + document.getElementById('inp-sum-2').value;
				const m3 = '• ' + document.getElementById('inp-sum-3').value;

				ctx.fillStyle = '#334155';
				ctx.font = '500 32px "Plus Jakarta Sans", sans-serif';
				let currentY = 380;
				currentY = drawWrappedText(ctx, m1, 90, currentY, 900, 48) + 24;
				currentY = drawWrappedText(ctx, m2, 90, currentY, 900, 48) + 24;
				currentY = drawWrappedText(ctx, m3, 90, currentY, 900, 48);

				// Kaynak
				ctx.fillStyle = '#ffffff';
				ctx.strokeStyle = '#cbd5e1';
				ctx.lineWidth = 2;
				roundRect(ctx, 90, 820, 900, 110, 12, true, true);
				ctx.fillStyle = '#64748b';
				ctx.font = '600 28px "Plus Jakarta Sans", sans-serif';
				ctx.fillText(document.getElementById('inp-source').value, 120, 888);

				// CTA Buton
				ctx.fillStyle = '#1f9a77';
				roundRect(ctx, 90, 980, 900, 120, 16, true, false);
				ctx.fillStyle = '#ffffff';
				ctx.font = '700 32px "Plus Jakarta Sans", sans-serif';
				ctx.textAlign = 'center';
				ctx.fillText('Haberin tamamı ve açık kaynaklar için link profilde', 540, 1055);
				ctx.textAlign = 'left';
			}

			return canvas.toDataURL('image/png');
		}

		// Yardımcı Metin Kaydırma
		function drawWrappedText(ctx, text, x, y, maxWidth, lineHeight) {
			const words = (text || '').split(' ');
			let line = '';
			for (let n = 0; n < words.length; n++) {
				const testLine = line + words[n] + ' ';
				const metrics = ctx.measureText(testLine);
				if (metrics.width > maxWidth && n > 0) {
					ctx.fillText(line, x, y);
					line = words[n] + ' ';
					y += lineHeight;
				} else {
					line = testLine;
				}
			}
			ctx.fillText(line, x, y);
			return y + lineHeight;
		}

		// Yuvarlatılmış Kutu Çizimi
		function roundRect(ctx, x, y, width, height, radius, fill, stroke) {
			ctx.beginPath();
			ctx.moveTo(x + radius, y);
			ctx.lineTo(x + width - radius, y);
			ctx.quadraticCurveTo(x + width, y, x + width, y + radius);
			ctx.lineTo(x + width, y + height - radius);
			ctx.quadraticCurveTo(x + width, y + height, x + width - radius, y + height);
			ctx.lineTo(x + radius, y + height);
			ctx.quadraticCurveTo(x, y + height, x, y + height - radius);
			ctx.lineTo(x, y + radius);
			ctx.quadraticCurveTo(x, y, x + radius, y);
			ctx.closePath();
			if (fill) ctx.fill();
			if (stroke) ctx.stroke();
		}

		// Tekli İndirme
		window.downloadSingle = function(slideNum) {
			const dataUrl = renderSlideToCanvas(slideNum);
			const a = document.createElement('a');
			a.download = `hepsiveri-slayt-0${slideNum}.png`;
			a.href = dataUrl;
			a.click();
		};

		// 4 Slaytı Birden İndir
		document.getElementById('btn-export-all').addEventListener('click', async () => {
			for (let i = 1; i <= 4; i++) {
				downloadSingle(i);
				await new Promise(r => setTimeout(r, 400));
			}
		});
	</script>
