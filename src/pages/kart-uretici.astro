<!DOCTYPE html>
<html lang="tr">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta name="robots" content="noindex, nofollow">
	<title>HepsiVeri - Instagram Kart & Görsel Üreticisi</title>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700;800&display=swap" rel="stylesheet">
	
	<style>
		:root {
			--font-main: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
			--font-mono: 'JetBrains Mono', monospace;
			--bg-canvas: #f4f4f5;
			--card-bg: #fbfbfa;
			--brand-purple: #4c1eb2;
			--brand-green: #1f9a77;
			--text-primary: #0f172a;
			--text-secondary: #334155;
			--text-muted: #64748b;
			--border: #e2e8f0;
		}

		* { box-sizing: border-box; margin: 0; padding: 0; }

		body {
			font-family: var(--font-main);
			background-color: var(--bg-canvas);
			color: var(--text-primary);
			line-height: 1.5;
			padding-bottom: 80px;
		}

		/* Üst Bar */
		.app-header {
			background: #ffffff;
			border-bottom: 1px solid var(--border);
			padding: 14px 24px;
			display: flex;
			justify-content: space-between;
			align-items: center;
			position: sticky;
			top: 0;
			z-index: 50;
		}

		.app-brand {
			display: flex;
			align-items: center;
			gap: 12px;
		}

		.app-logo-img {
			height: 30px;
			width: auto;
			display: block;
			object-fit: contain;
		}

		.app-badge {
			background: #f0fdf4;
			color: var(--brand-green);
			border: 1px solid #bbf7d0;
			font-size: 11px;
			font-weight: 700;
			padding: 4px 8px;
			border-radius: 6px;
		}

		.header-actions {
			display: flex;
			gap: 12px;
		}

		.btn-download-all {
			background: var(--brand-green);
			color: #ffffff;
			border: none;
			padding: 10px 20px;
			border-radius: 8px;
			font-weight: 700;
			font-size: 14px;
			cursor: pointer;
			display: flex;
			align-items: center;
			gap: 8px;
			transition: background 0.2s;
		}
		.btn-download-all:hover { background: #15803d; }

		/* Ana Düzen */
		.studio-container {
			max-width: 1600px;
			margin: 24px auto;
			padding: 0 24px;
			display: grid;
			grid-template-columns: 460px 1fr;
			gap: 32px;
			align-items: start;
		}

		/* Sol Form Alanı */
		.editor-sidebar {
			background: #ffffff;
			border: 1px solid var(--border);
			border-radius: 12px;
			padding: 24px;
			max-height: calc(100vh - 120px);
			overflow-y: auto;
		}

		.sidebar-section {
			margin-bottom: 24px;
			padding-bottom: 20px;
			border-bottom: 1px solid var(--border);
		}
		.sidebar-section:last-child { border-bottom: none; margin-bottom: 0; }

		.section-title {
			font-size: 14px;
			font-weight: 800;
			color: var(--text-primary);
			margin-bottom: 12px;
			display: flex;
			align-items: center;
			gap: 8px;
			letter-spacing: -0.2px;
		}

		.form-group {
			margin-bottom: 14px;
		}
		.form-label {
			display: block;
			font-size: 12px;
			font-weight: 600;
			color: var(--text-secondary);
			margin-bottom: 6px;
		}

		.form-select, .form-input, .form-textarea {
			width: 100%;
			padding: 10px 12px;
			border: 1px solid var(--border);
			border-radius: 8px;
			font-family: inherit;
			font-size: 13px;
			color: var(--text-primary);
			background: #ffffff;
			outline: none;
			transition: border-color 0.2s;
		}
		.form-select:focus, .form-input:focus, .form-textarea:focus {
			border-color: var(--brand-purple);
			box-shadow: 0 0 0 2px rgba(76, 30, 178, 0.1);
		}

		.form-row {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 12px;
		}

		/* Sağ Canlı Önizleme Alanı */
		.preview-area {
			display: flex;
			flex-direction: column;
			gap: 20px;
		}

		.preview-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
			gap: 20px;
		}

		/* Tekil Kart Slayt Önizlemesi (4:5 Aspect Ratio) */
		.slide-wrapper {
			background: #ffffff;
			border: 1px solid var(--border);
			border-radius: 12px;
			padding: 12px;
			box-shadow: 0 2px 8px rgba(0,0,0,0.04);
		}

		.slide-header {
			display: flex;
			justify-content: space-between;
			align-items: center;
			margin-bottom: 10px;
			font-size: 12px;
			font-weight: 700;
			color: var(--text-muted);
		}

		.btn-save-slide {
			background: #ffffff;
			border: 1px solid var(--border);
			padding: 4px 10px;
			border-radius: 6px;
			font-size: 11px;
			font-weight: 600;
			cursor: pointer;
			transition: all 0.2s;
		}
		.btn-save-slide:hover {
			background: var(--brand-purple);
			color: #ffffff;
			border-color: var(--brand-purple);
		}

		/* 1080x1350 px Kart Kanvası */
		.slide-card {
			width: 100%;
			aspect-ratio: 4 / 5;
			background: var(--card-bg);
			border: 1px solid rgba(0,0,0,0.08);
			border-radius: 8px;
			padding: 24px;
			display: flex;
			flex-direction: column;
			justify-content: space-between;
			position: relative;
			overflow: hidden;
			box-shadow: inset 0 0 0 1px rgba(255,255,255,0.6);
		}

		/* Kart İçi Tipografi */
		.card-topbar {
			display: flex;
			justify-content: space-between;
			align-items: center;
		}

		.card-logo {
			display: flex;
			align-items: center;
		}

		.card-logo-img {
			height: 34px;
			width: auto;
			object-fit: contain;
			display: block;
		}

		.card-tag {
			background: rgba(31, 154, 119, 0.1);
			color: var(--brand-green);
			font-size: 11px;
			font-weight: 700;
			padding: 3px 8px;
			border-radius: 4px;
		}

		.card-counter {
			font-family: var(--font-mono);
			font-size: 11px;
			font-weight: 700;
			color: var(--text-muted);
		}

		/* Slayt 1: Kapak */
		.cover-center {
			margin: auto 0;
		}

		.cover-headline {
			font-size: 20px;
			font-weight: 800;
			line-height: 1.35;
			color: var(--text-primary);
			letter-spacing: -0.4px;
			margin-bottom: 12px;
		}

		.cover-sub {
			font-size: 12px;
			line-height: 1.5;
			color: var(--text-secondary);
			font-weight: 500;
		}

		/* Slayt 2: Kıyaslama */
		.compare-title {
			font-size: 16px;
			font-weight: 800;
			color: var(--text-primary);
			margin-bottom: 16px;
			text-align: center;
		}

		.compare-boxes {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 10px;
			margin-bottom: 14px;
		}

		.stat-box {
			background: #ffffff;
			border: 1px solid var(--border);
			border-radius: 8px;
			padding: 12px 8px;
			text-align: center;
		}

		.stat-box.highlight {
			background: #f0fdf4;
			border-color: var(--brand-green);
		}

		.stat-label {
			font-size: 11px;
			font-weight: 600;
			color: var(--text-muted);
			margin-bottom: 6px;
		}
		.stat-box.highlight .stat-label { color: var(--brand-green); font-weight: 700; }

		.stat-val {
			font-family: var(--font-mono);
			font-size: 26px;
			font-weight: 800;
			color: var(--text-primary);
			line-height: 1.1;
		}
		.stat-box.highlight .stat-val { color: var(--brand-green); }

		.compare-note {
			font-size: 11px;
			line-height: 1.45;
			color: var(--text-secondary);
			background: #ffffff;
			border: 1px solid var(--border);
			border-radius: 6px;
			padding: 8px 10px;
			text-align: center;
			font-weight: 500;
		}

		/* Slayt 3: Büyük Rakam */
		.big-stat-wrap {
			text-align: center;
			margin: auto 0;
		}

		.big-stat-eyebrow {
			font-size: 12px;
			font-weight: 700;
			color: var(--brand-green);
			margin-bottom: 8px;
		}

		.big-stat-number {
			font-family: var(--font-mono);
			font-size: 54px;
			font-weight: 800;
			color: var(--brand-purple);
			line-height: 1;
			margin-bottom: 14px;
			letter-spacing: -1px;
		}

		.big-stat-desc {
			font-size: 12px;
			line-height: 1.5;
			color: var(--text-primary);
			background: #ffffff;
			border: 1px solid var(--border);
			border-radius: 8px;
			padding: 12px 14px;
			font-weight: 500;
			text-align: left;
		}

		/* Slayt 4: Özet ve CTA */
		.summary-title {
			font-size: 16px;
			font-weight: 800;
			color: var(--text-primary);
			margin-bottom: 12px;
		}

		.summary-list {
			list-style: none;
			margin-bottom: 14px;
		}

		.summary-item {
			font-size: 11px;
			line-height: 1.45;
			color: var(--text-secondary);
			margin-bottom: 8px;
			display: flex;
			gap: 6px;
			align-items: flex-start;
		}

		.summary-bullet {
			color: var(--brand-green);
			font-weight: 800;
			flex-shrink: 0;
		}

		.source-box {
			font-size: 10px;
			color: var(--text-muted);
			background: #ffffff;
			border: 1px solid var(--border);
			border-radius: 6px;
			padding: 6px 10px;
			margin-bottom: 12px;
			font-weight: 600;
		}

		.cta-banner {
			background: var(--brand-green);
			color: #ffffff;
			border-radius: 6px;
			padding: 8px 10px;
			text-align: center;
			font-size: 11px;
			font-weight: 700;
		}

		/* Kart Alt Bilgisi */
		.card-footer {
			display: flex;
			justify-content: space-between;
			align-items: center;
			font-size: 10px;
			font-weight: 600;
			color: var(--text-muted);
			padding-top: 10px;
			border-top: 1px solid rgba(0,0,0,0.06);
		}

		/* Gizli Export Canvası */
		#export-canvas {
			display: none;
		}
	</style>
</head>
<body>

	<!-- Üst Çubuk -->
	<header class="app-header">
		<div class="app-brand">
			<img src="/logo.png" alt="HepsiVeri" class="app-logo-img" />
			<span class="app-badge">Sosyal Medya Stüdyosu</span>
		</div>
		<div class="header-actions">
			<button class="btn-download-all" id="btn-export-all">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
					<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
					<polyline points="7 10 12 15 17 10"></polyline>
					<line x1="12" y1="15" x2="12" y2="3"></line>
				</svg>
				4 Slaytı Birden İndir (1080x1350)
			</button>
		</div>
	</header>

	<div class="studio-container">

		<!-- Sol Editör Formu -->
		<aside class="editor-sidebar">
			
			<div class="sidebar-section">
				<h2 class="section-title">📂 1. Haberi Seçin (Otomatik Doldur)</h2>
				<div class="form-group">
					<label class="form-label">Sitedeki Son Haberler</label>
					<select class="form-select" id="post-selector">
						<option value="">Bir haber seçin...</option>
						{postsPayload.map((p, idx) => (
							<option value={idx}>
								{p.isDraft ? '[Taslak] ' : ''}{p.title.length > 55 ? p.title.slice(0, 55) + '...' : p.title} ({p.date})
							</option>
						))}
					</select>
				</div>
			</div>

			<div class="sidebar-section">
				<h2 class="section-title">🎯 2. Slayt 1 (Kapak)</h2>
				<div class="form-group">
					<label class="form-label">Kategori Rozeti</label>
					<input class="form-input" id="inp-cat" value="Ekonomi / Veri Analizi">
				</div>
				<div class="form-group">
					<label class="form-label">Ana Başlık (Soru / Vurucu Cümle)</label>
					<textarea class="form-textarea" id="inp-title" rows="3">Türkiye'de çalışan her üç kadından biri neden sosyal güvencesiz?</textarea>
				</div>
				<div class="form-group">
					<label class="form-label">Alt Açıklama (Spot)</label>
					<textarea class="form-textarea" id="inp-desc" rows="2">TEPAV ve SGK verileri, kadın çalışanların çifte kıskaç altında olduğunu ortaya koydu.</textarea>
				</div>
			</div>

			<div class="sidebar-section">
				<h2 class="section-title">⚖️ 3. Slayt 2 (Kıyaslama)</h2>
				<div class="form-group">
					<label class="form-label">Bölüm Başlığı</label>
					<input class="form-input" id="inp-comp-title" value="Kayıt Dışılık Makası Açılıyor">
				</div>
				<div class="form-row">
					<div class="form-group">
						<label class="form-label">Sol Etiket</label>
						<input class="form-input" id="inp-comp-l-label" value="Erkeklerde Kayıt Dışı">
						<label class="form-label" style="margin-top:6px;">Sol Oran / Sayı</label>
						<input class="form-input" id="inp-comp-l-val" value="%21,9">
					</div>
					<div class="form-group">
						<label class="form-label">Sağ Etiket (Vurgulu)</label>
						<input class="form-input" id="inp-comp-r-label" value="Kadınlarda Kayıt Dışı">
						<label class="form-label" style="margin-top:6px;">Sağ Oran / Sayı</label>
						<input class="form-input" id="inp-comp-r-val" value="%29,4">
					</div>
				</div>
				<div class="form-group">
					<label class="form-label">Fark Özeti / Not</label>
					<input class="form-input" id="inp-comp-note" value="Kadın çalışanlar aleyhine fark 7,5 puana ulaştı.">
				</div>
			</div>

			<div class="sidebar-section">
				<h2 class="section-title">💥 4. Slayt 3 (Büyük Rakam)</h2>
				<div class="form-group">
					<label class="form-label">Üst Etiket</label>
					<input class="form-input" id="inp-stat-eyebrow" value="Tarımda Kadın Emeği">
				</div>
				<div class="form-group">
					<label class="form-label">Büyük Rakam / Veri</label>
					<input class="form-input" id="inp-stat-number" value="%91,9">
				</div>
				<div class="form-group">
					<label class="form-label">Rakamın Anlamı / Açıklaması</label>
