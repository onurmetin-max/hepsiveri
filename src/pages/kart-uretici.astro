---
import { getCollection } from 'astro:content';

// Sitedeki son haberleri çek (Taslaklar hariç)
const allPosts = await getCollection('blog', ({ data }) => data.status !== 'Taslak');
allPosts.sort((a, b) => new Date(b.data.pubDate || 0).getTime() - new Date(a.data.pubDate || 0).getTime());

// Formun otomatik doldurması için gerekli veriler
const postsPayload = allPosts.slice(0, 25).map(p => {
	// Madde imli verileri tespit et
	const bulletMatches = [];
	const regex = /^[*-]\s+\*\*([^*]+)\*\*[:\s]*(.*)$/gm;
	let match;
	while ((match = regex.exec(p.body)) !== null) {
		const label = match[1].replace(/:+$/, '').trim();
		const val = match[2].replace(/\[(.*?)\]\(.*?\)/g, '$1').replace(/\*\*/g, '').trim();
		if (val && (val.includes('%') || val.includes('TL') || /\d+/.test(val))) {
			bulletMatches.push({ label, val });
		}
		if (bulletMatches.length >= 4) break;
	}

	return {
		slug: p.slug,
		title: p.data.title,
		category: p.data.category || 'Veri Haberciliği',
		description: p.data.description || '',
		tags: p.data.tags || [],
		bullets: bulletMatches,
		date: p.data.pubDate ? new Date(p.data.pubDate).toLocaleDateString('tr-TR') : ''
	};
});
