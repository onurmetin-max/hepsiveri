						<div class="big-stat-wrap">
							<div class="big-stat-eyebrow" id="view-stat-eyebrow">TARIMDA KADIN EMEĞİ</div>
							<div class="big-stat-number" id="view-stat-number">%91,9</div>
							<div class="big-stat-desc" id="view-stat-desc">Tarımda çalışan kadınların neredeyse tamamı hiçbir sosyal güvenlik kaydı olmadan güvencesiz çalışıyor.</div>
						</div>
						<div class="card-footer">
							<span>Kaydırın ➔</span>
							<span>hepsiveri.com</span>
						</div>
					</div>
				</div>

				<!-- Slayt 4 -->
				<div class="slide-wrapper">
					<div class="slide-header">
						<span>Slayt 4 (Özet & CTA)</span>
						<button class="btn-save-slide" onclick="downloadSingle(4)">PNG İndir</button>
					</div>
					<div class="slide-card" id="card-4">
						<div class="card-topbar">
							<div class="card-logo"><span class="p1">Hepsi</span><span class="p2">Veri</span></div>
							<div class="card-counter">04/04</div>
						</div>
						<div>
							<h3 class="summary-title">Özet ve Temel Çıkarımlar</h3>
							<ul class="summary-list">
								<li class="summary-item"><span class="summary-bullet">✓</span><span id="view-sum-1">Her 3 kadından 1'i hiçbir sosyal güvenceye sahip değil.</span></li>
								<li class="summary-item"><span class="summary-bullet">✓</span><span id="view-sum-2">Sendikalı kadın işçi oranı yalnızca %10,8'de kaldı.</span></li>
								<li class="summary-item"><span class="summary-bullet">✓</span><span id="view-sum-3">Kırsalda ücretsiz aile işçiliği güvencesizliği derinleştiriyor.</span></li>
							</ul>
							<div class="source-box" id="view-source">Kaynak: TEPAV İstihdam İzleme Bülteni & SGK Temmuz 2026</div>
							<div class="cta-banner">Haberin tamamı için profildeki linke tıklayın • hepsiveri.com</div>
						</div>
						<div class="card-footer">
							<span>Kaydet & Paylaş</span>
							<span>hepsiveri.com</span>
						</div>
					</div>
				</div>

			</div>
		</main>

	</div>

	<!-- Arka planda 1080x1350 PNG çizen Gizli Canvas -->
	<canvas id="export-canvas" width="1080" height="1350"></canvas>

	<!-- Veriler ve Script -->
	<script is:inline define:vars={{ postsPayload }}>
		// Form - Önizleme Canlı Bağlantısı
		const bindInput = (inpId, viewId) => {
			const inp = document.getElementById(inpId);
			const view = document.getElementById(viewId);
			if (inp && view) {
				inp.addEventListener('input', () => { view.innerText = inp.value; });
			}
		};

		bindInput('inp-cat', 'view-cat');
		bindInput('inp-title', 'view-title');
		bindInput('inp-desc', 'view-desc');
		bindInput('inp-comp-title', 'view-comp-title');
		bindInput('inp-comp-l-label', 'view-comp-l-label');
		bindInput('inp-comp-l-val', 'view-comp-l-val');
		bindInput('inp-comp-r-label', 'view-comp-r-label');
		bindInput('inp-comp-r-val', 'view-comp-r-val');
		bindInput('inp-comp-note', 'view-comp-note');
		bindInput('inp-stat-eyebrow', 'view-stat-eyebrow');
		bindInput('inp-stat-number', 'view-stat-number');
		bindInput('inp-stat-desc', 'view-stat-desc');
		bindInput('inp-sum-1', 'view-sum-1');
		bindInput('inp-sum-2', 'view-sum-2');
		bindInput('inp-sum-3', 'view-sum-3');
		bindInput('inp-source', 'view-source');

		// Haber Seçildiğinde Otomatik Doldur
		const selector = document.getElementById('post-selector');
		selector.addEventListener('change', (e) => {
			const idx = e.target.value;
			if (idx === '') return;
			const post = postsPayload[idx];
			if (!post) return;

			document.getElementById('inp-cat').value = post.category.toUpperCase() + ' / VERİ ANALİZİ';
			document.getElementById('inp-title').value = post.title;
			document.getElementById('inp-desc').value = post.description || '';

			if (post.bullets && post.bullets.length >= 2) {
				document.getElementById('inp-comp-l-label').value = post.bullets[0].label;
				document.getElementById('inp-comp-l-val').value = post.bullets[0].val;
				document.getElementById('inp-comp-r-label').value = post.bullets[1].label;
				document.getElementById('inp-comp-r-val').value = post.bullets[1].val;
			}

			if (post.bullets && post.bullets.length >= 3) {
				document.getElementById('inp-stat-number').value = post.bullets[2].val;
				document.getElementById('inp-stat-eyebrow').value = post.bullets[2].label.toUpperCase();
			}

			// Önizlemeleri tetikle
			const inputs = document.querySelectorAll('.form-input, .form-textarea');
			inputs.forEach(i => i.dispatchEvent(new Event('input')));
		});

		// 1080x1350 Piksel Yüksek Çözünürlüklü Canvas Çizici
		function renderSlideToCanvas(slideNum) {
			const canvas = document.getElementById('export-canvas');
			const ctx = canvas.getContext('2d');
			const w = 1080;
			const h = 1350;

			// 1. Zemin Rengi (#FBFBFA)
			ctx.fillStyle = '#fbfbfa';
			ctx.fillRect(0, 0, w, h);

			// 2. İnce Dış Çerçeve
			ctx.strokeStyle = '#e2e8f0';
			ctx.lineWidth = 4;
			ctx.strokeRect(40, 40, w - 80, h - 80);

			// 3. Logo Çizimi
			ctx.font = '800 48px "Plus Jakarta Sans", sans-serif';
			ctx.fillStyle = '#4c1eb2';
			ctx.fillText('Hepsi', 90, 140);
			const hepsiWidth = ctx.measureText('Hepsi').width;
			ctx.fillStyle = '#1f9a77';
			ctx.fillText('Veri', 90 + hepsiWidth, 140);

			// Slayt Numarası (Sağ Üst)
			ctx.font = '700 32px "JetBrains Mono", monospace';
			ctx.fillStyle = '#64748b';
			ctx.textAlign = 'right';
			ctx.fillText(`0${slideNum}/04`, w - 90, 140);
			ctx.textAlign = 'left';

			// Alt Footer Çizgisi
			ctx.strokeStyle = '#e2e8f0';
			ctx.lineWidth = 2;
			ctx.beginPath();
			ctx.moveTo(90, h - 140);
			ctx.lineTo(w - 90, h - 140);
			ctx.stroke();

			ctx.font = '600 28px "Plus Jakarta Sans", sans-serif';
			ctx.fillStyle = '#64748b';
			ctx.fillText('Kaydırın ➔', 90, h - 90);
			ctx.textAlign = 'right';
			ctx.fillText('hepsiveri.com', w - 90, h - 90);
			ctx.textAlign = 'left';

			// Slayta Özel İçerik Çizimi
			if (slideNum === 1) {
				// Kategori Rozeti
				const cat = document.getElementById('inp-cat').value;
				ctx.fillStyle = '#1f9a77';
				ctx.font = '800 28px "Plus Jakarta Sans", sans-serif';
				ctx.fillText(cat, 90, 280);

				// Ana Başlık (Metin Kaydırma ile)
				const title = document.getElementById('inp-title').value;
				ctx.fillStyle = '#0f172a';
				ctx.font = '800 68px "Plus Jakarta Sans", sans-serif';
				drawWrappedText(ctx, title, 90, 420, 900, 90);

				// Spot
				const desc = document.getElementById('inp-desc').value;
				ctx.fillStyle = '#334155';
				ctx.font = '500 36px "Plus Jakarta Sans", sans-serif';
				drawWrappedText(ctx, desc, 90, 850, 900, 56);
			} else if (slideNum === 2) {
				const compTitle = document.getElementById('inp-comp-title').value;
				ctx.fillStyle = '#0f172a';
				ctx.font = '800 56px "Plus Jakarta Sans", sans-serif';
				drawWrappedText(ctx, compTitle, 90, 300, 900, 75);

				// Sol Kutu (Erkek)
				ctx.fillStyle = '#ffffff';
				ctx.strokeStyle = '#cbd5e1';
				ctx.lineWidth = 3;
				roundRect(ctx, 90, 480, 420, 360, 20, true, true);

				ctx.fillStyle = '#64748b';
				ctx.font = '600 30px "Plus Jakarta Sans", sans-serif';
				ctx.textAlign = 'center';
				ctx.fillText(document.getElementById('inp-comp-l-label').value, 300, 570);

				ctx.fillStyle = '#0f172a';
				ctx.font = '800 84px "JetBrains Mono", monospace';
				ctx.fillText(document.getElementById('inp-comp-l-val').value, 300, 720);

				// Sağ Kutu (Kadın - Vurgulu)
				ctx.fillStyle = '#f0fdf4';
				ctx.strokeStyle = '#1f9a77';
				ctx.lineWidth = 4;
				roundRect(ctx, 570, 480, 420, 360, 20, true, true);

				ctx.fillStyle = '#1f9a77';
				ctx.font = '700 30px "Plus Jakarta Sans", sans-serif';
				ctx.fillText(document.getElementById('inp-comp-r-label').value, 780, 570);

				ctx.fillStyle = '#1f9a77';
				ctx.font = '800 84px "JetBrains Mono", monospace';
				ctx.fillText(document.getElementById('inp-comp-r-val').value, 780, 720);
				ctx.textAlign = 'left';

				// Fark Notu
				ctx.fillStyle = '#ffffff';
				ctx.strokeStyle = '#e2e8f0';
				roundRect(ctx, 90, 900, 900, 160, 16, true, true);

				ctx.fillStyle = '#334155';
				ctx.font = '600 36px "Plus Jakarta Sans", sans-serif';
				drawWrappedText(ctx, document.getElementById('inp-comp-note').value, 130, 995, 820, 50);
			} else if (slideNum === 3) {
				ctx.textAlign = 'center';
				ctx.fillStyle = '#1f9a77';
				ctx.font = '800 36px "Plus Jakarta Sans", sans-serif';
				ctx.fillText(document.getElementById('inp-stat-eyebrow').value, 540, 360);

				ctx.fillStyle = '#4c1eb2';
				ctx.font = '800 170px "JetBrains Mono", monospace';
				ctx.fillText(document.getElementById('inp-stat-number').value, 540, 580);
				ctx.textAlign = 'left';

				ctx.fillStyle = '#ffffff';
				ctx.strokeStyle = '#e2e8f0';
				ctx.lineWidth = 3;
				roundRect(ctx, 90, 720, 900, 320, 20, true, true);

				ctx.fillStyle = '#0f172a';
				ctx.font = '500 40px "Plus Jakarta Sans", sans-serif';
				drawWrappedText(ctx, document.getElementById('inp-stat-desc').value, 140, 830, 800, 64);
			} else if (slideNum === 4) {
				ctx.fillStyle = '#0f172a';
				ctx.font = '800 52px "Plus Jakarta Sans", sans-serif';
				ctx.fillText('Özet ve Temel Çıkarımlar', 90, 280);

				const m1 = '• ' + document.getElementById('inp-sum-1').value;
				const m2 = '• ' + document.getElementById('inp-sum-2').value;
				const m3 = '• ' + document.getElementById('inp-sum-3').value;

				ctx.fillStyle = '#334155';
				ctx.font = '500 34px "Plus Jakarta Sans", sans-serif';
				drawWrappedText(ctx, m1, 90, 380, 900, 52);
				drawWrappedText(ctx, m2, 90, 520, 900, 52);
				drawWrappedText(ctx, m3, 90, 660, 900, 52);

				// Kaynak
				ctx.fillStyle = '#ffffff';
				ctx.strokeStyle = '#cbd5e1';
				ctx.lineWidth = 2;
				roundRect(ctx, 90, 820, 900, 110, 12, true, true);
				ctx.fillStyle = '#64748b';
				ctx.font = '600 28px "Plus Jakarta Sans", sans-serif';
				ctx.fillText(document.getElementById('inp-source').value, 120, 888);

				// CTA Buton
				ctx.fillStyle = '#1f9a77';
				roundRect(ctx, 90, 980, 900, 120, 16, true, false);
				ctx.fillStyle = '#ffffff';
				ctx.font = '700 32px "Plus Jakarta Sans", sans-serif';
				ctx.textAlign = 'center';
				ctx.fillText('Haberin tamamı ve açık veri için link profilde', 540, 1055);
				ctx.textAlign = 'left';
			}

			return canvas.toDataURL('image/png');
		}

		// Yardımcı Metin Kaydırma
		function drawWrappedText(ctx, text, x, y, maxWidth, lineHeight) {
			const words = text.split(' ');
			let line = '';
			for (let n = 0; n < words.length; n++) {
				const testLine = line + words[n] + ' ';
				const metrics = ctx.measureText(testLine);
				if (metrics.width > maxWidth && n > 0) {
					ctx.fillText(line, x, y);
					line = words[n] + ' ';
					y += lineHeight;
				} else {
					line = testLine;
				}
			}
			ctx.fillText(line, x, y);
		}

		// Yuvarlatılmış Kutu Çizimi
		function roundRect(ctx, x, y, width, height, radius, fill, stroke) {
			ctx.beginPath();
			ctx.moveTo(x + radius, y);
			ctx.lineTo(x + width - radius, y);
			ctx.quadraticCurveTo(x + width, y, x + width, y + radius);
			ctx.lineTo(x + width, y + height - radius);
			ctx.quadraticCurveTo(x + width, y + height, x + width - radius, y + height);
			ctx.lineTo(x + radius, y + height);
			ctx.quadraticCurveTo(x, y + height, x, y + height - radius);
			ctx.lineTo(x, y + radius);
			ctx.quadraticCurveTo(x, y, x + radius, y);
			ctx.closePath();
			if (fill) ctx.fill();
			if (stroke) ctx.stroke();
		}

		// Tekli İndirme
		window.downloadSingle = function(slideNum) {
			const dataUrl = renderSlideToCanvas(slideNum);
			const a = document.createElement('a');
			a.download = `hepsiveri-slayt-0${slideNum}.png`;
			a.href = dataUrl;
			a.click();
		};

		// 4 Slaytı Birden İndir
		document.getElementById('btn-export-all').addEventListener('click', async () => {
			for (let i = 1; i <= 4; i++) {
				downloadSingle(i);
				await new Promise(r => setTimeout(r, 400));
			}
		});
	</script>
</body>
</html>
