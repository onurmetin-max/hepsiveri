import { getCollection } from 'astro:content';

// Sitedeki tüm haberleri çek (Taslaklar dahil, en yeniden eskiye)
const allPosts = await getCollection('blog');
allPosts.sort((a, b) => new Date(b.data.pubDate || 0).getTime() - new Date(a.data.pubDate || 0).getTime());

// Formun ve slaytların otomatik doldurulması için akıllı veri çıkarıcı
const postsPayload = allPosts.slice(0, 45).map(p => {
	const content = p.body || '';
	const title = p.data.title || '';
	const category = (p.data.category || 'Veri Haberciliği') + ' / Veri Analizi';
	const desc = p.data.description || '';

	// 1. Madde imli satırları tespit et
	const bulletLines: string[] = [];
	const bRegex = /^[*-]\s+(.+)$/gm;
	let bm;
	while ((bm = bRegex.exec(content)) !== null) {
		const raw = bm[1].replace(/\[(.*?)\]\(.*?\)/g, '$1').replace(/\*\*/g, '').trim();
		bulletLines.push(raw);
	}

	// 2. Yüzde ve kalın veri istatistiklerini topla
	const boldStats: string[] = [];
	const sRegex = /\*\*([%0-9][^*]{1,25})\*\*/g;
	let sm;
	while ((sm = sRegex.exec(content)) !== null) {
		const clean = sm[1].trim();
		if (clean.includes('%') || clean.includes('TL') || clean.includes('milyar') || clean.includes('milyon') || clean.includes('bin') || /\d+/.test(clean)) {
			if (!boldStats.includes(clean)) boldStats.push(clean);
		}
	}

	// 3. Tablo satırlarını tespit et
	const tableRows: string[][] = [];
	const tableRegex = /^\|(.+)\|$/gm;
	let tm;
	while ((tm = tableRegex.exec(content)) !== null) {
		const cells = tm[1].split('|').map(c => c.trim().replace(/\*\*/g, ''));
		if (cells.length >= 2 && !cells[0].includes('---') && !cells[0].toLowerCase().includes('sektör') && !cells[0].toLowerCase().includes('alan') && !cells[0].toLowerCase().includes('yıl')) {
			tableRows.push(cells);
		}
	}

	// 4. Otomatik Mod Tespiti: Gerçek bir veri ikiliği/tablosu var mı?
	const isDataHeavy = tableRows.length >= 2 || (boldStats.length >= 2 && (category.includes('Ekonomi') || bulletLines.some(b => b.includes(':'))));
	const recommendedMode = isDataHeavy ? 'data' : 'concept';

	// 5. Resmi kaynak tespiti
	let source = 'Kaynak: HepsiVeri Araştırma & Açık Veri';
	const knownSources = ['TÜİK', 'SGK', 'TEPAV', 'OECD', 'Eurostat', 'TCMB', 'MEB', 'Sağlık Bakanlığı', 'İçişleri Bakanlığı', 'Adalet Bakanlığı', 'İŞKUR', 'BDDK', 'EGM', 'Dictionary.com', 'Meltwater'];
	for (const s of knownSources) {
		if (content.includes(s) || (p.data.tags || []).includes(s) || title.includes(s)) {
			source = `Kaynak: ${s} Analizi & Açık Kaynak Veri`;
			break;
		}
	}

	// --- A) Sayısal Kıyaslama Modu Verileri ---
	let compTitle = 'Öne Çıkan Karşılaştırmalar';
	let compLLabel = 'Temel Oran';
	let compLVal = boldStats[0] || '%50,0';
	let compRLabel = 'Öne Çıkan Pay';
	let compRVal = boldStats[1] || '%65,0';
	let compNote = 'Veriler resmi kamu kayıtları ve istatistiki raporlara dayanmaktadır.';

	if (tableRows.length >= 2) {
		compTitle = 'Sektörel Dağılım ve Karşılaştırma';
		compLLabel = tableRows[0][0].slice(0, 24);
		compLVal = tableRows[0][1] || boldStats[0] || '%50';
		compRLabel = tableRows[1][0].slice(0, 24);
		compRVal = tableRows[1][1] || boldStats[1] || '%30';
		compNote = `${compLLabel} ile ${compRLabel} arasındaki gösterge farkı dikkat çekiyor.`;
	} else if (bulletLines.length >= 2) {
		const b0 = bulletLines[0];
		const b1 = bulletLines[1];
		if (b0.includes(':')) {
			const parts = b0.split(':');
			compLLabel = parts[0].slice(0, 24);
			compLVal = parts[1].trim();
		} else {
			compLLabel = 'Birinci Gösterge';
			compLVal = boldStats[0] || '%25';
		}
		if (b1.includes(':')) {
			const parts = b1.split(':');
			compRLabel = parts[0].slice(0, 24);
			compRVal = parts[1].trim();
		} else {
			compRLabel = 'İkinci Gösterge';
			compRVal = boldStats[1] || '%75';
		}
		compNote = desc.slice(0, 80) + (desc.length > 80 ? '...' : '');
	}

	let statEyebrow = 'Öne Çıkan Ana Gösterge';
	let statNumber = boldStats[0] || '%50';
	let statDesc = desc || 'Açık veri analizinde kaydedilen en dikkat çekici değer.';

	const titleNumberMatch = title.match(/%\s*[\d,.]+|[\d,.]+\s*(?:milyar|trilyon|milyon|bin)?\s*TL/i);
	if (titleNumberMatch) {
		statNumber = titleNumberMatch[0].trim();
		statEyebrow = 'Raporda Öne Çıkan Değer';
		statDesc = title;
	} else if (boldStats.length > 0) {
		statNumber = boldStats[0];
	}

	// --- B) Kavram, Alıntı ve Analiz Modu Verileri ---
	let conceptTitle = 'Kavramın Anlamı ve Tanımı';
	const titleTermMatch = title.match(/["“']([^"”']+)["”']/i);
	if (titleTermMatch) {
		conceptTitle = `"${titleTermMatch[1]}" Ne Anlama Geliyor?`;
	}

	let conceptQuote = '';
	const defMatch = content.match(/tanımına göre\s+([^.\n]+[.])/i) ||
	                 content.match(/“([^”]{25,180})”/) ||
	                 content.match(/"([^"]{25,180})"/);
	if (defMatch) {
		conceptQuote = defMatch[1].replace(/^["'“]|["'”]$/g, '').trim();
		if (!conceptQuote.endsWith('.')) conceptQuote += '.';
	} else {
		conceptQuote = desc || title;
	}

	let conceptContext = 'İnternet şakası olarak başlayan akım, modern kültürün ve dilin merkezine yerleşti.';
	const paragraphs = content.split(/\r?\n\r?\n/).filter(p => !p.startsWith('#') && !p.startsWith('<') && !p.startsWith('---') && p.length > 60);
	if (paragraphs.length > 1) {
		conceptContext = paragraphs[1].replace(/<[^>]+>/g, '').slice(0, 110) + '...';
	}

	let conceptStatNumber = '2026 Trendi';
	let conceptStatEyebrow = 'Kullanım ve Etkileşim Artışı';
	let conceptStatDesc = desc || 'Sosyal medyada ve aramalarda dikkat çeken kolektif eğilim kaydedildi.';

	const percMatch = content.match(/yüzde\s*([\d.,]+)\s*(?:arttı|yükseldi|artış|oranında)/i) || content.match(/%\s*([\d.,]+)/);
	if (percMatch) {
		conceptStatNumber = `+%${percMatch[1]}`;
		conceptStatEyebrow = 'Aramalarda ve Kullanımda Patlama';
		conceptStatDesc = `Kelimenin kullanımı ve aramaları 2026 yılında yaklaşık yüzde ${percMatch[1]} artış gösterdi.`;
	}

	// --- C) Slayt 4 Özet Çıkarımları ---
	let sum1 = bulletLines[0] ? bulletLines[0].slice(0, 95) : desc.slice(0, 85);
	let sum2 = bulletLines[1] ? bulletLines[1].slice(0, 95) : (boldStats[1] ? `Öne çıkan veri boyutu: ${boldStats[1]}` : 'Resmi raporda ve araştırmada paylaşılan temel göstergeler incelendi.');
	let sum3 = bulletLines[2] ? bulletLines[2].slice(0, 95) : 'Haberin tam metni, veri tabloları ve açık kaynaklar sitemizde.';

	return {
		slug: p.id || p.slug || '',
		isDraft: p.data.status === 'Taslak',
		recommendedMode,
		title,
		category,
		desc,
		// Data modu alanları
		compTitle,
		compLLabel,
		compLVal,
		compRLabel,
		compRVal,
		compNote,
		statEyebrow,
		statNumber,
		statDesc,
		// Concept modu alanları
		conceptTitle,
		conceptQuote,
		conceptContext,
		conceptStatEyebrow,
		conceptStatNumber,
		conceptStatDesc,
		// Özet
		sum1,
		sum2,
		sum3,
		source,
		date: p.data.pubDate ? new Date(p.data.pubDate).toLocaleDateString('tr-TR') : ''
	};
});
